# Google Tag Manager container (public ID). Analytics/Ads tags are managed in GTM.
PUBLIC_GTM_CONTAINER_ID=GTM-5GTPR59L

# Force noindex on any host (local preview, etc.)
PUBLIC_NOINDEX=false

