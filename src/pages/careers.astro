---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RecognitionGrid from "@/components/patterns/RecognitionGrid.astro";
import { SITE_URL, PUBLIC_EMAIL } from "@/constants/site";

const whyItems = [
  {
    title: "Clients who fit your work",
    body: "We match clients to clinicians based on clinical focus, style, and availability, so your caseload reflects the work you do best.",
  },
  {
    title: "Less administrative weight",
    body: "Intake, scheduling support, and payment conversations are handled with care before clients reach you, so sessions can stay about the clinical work.",
  },
  {
    title: "Schedule on your terms",
    body: "Mornings, evenings, weekdays, weekends. You set the hours and days that work for your life, and we match clients to them.",
  },
  {
    title: "A practice sized to you",
    body: "You shape how full your practice is, and can adjust as life changes. We want clinicians doing their best work, not their most work.",
  },
  {
    title: "Telehealth-first",
    body: "Most sessions are online, so there is no commute between clients. In-person options in the Cary and Raleigh area may be possible as the practice grows.",
  },
  {
    title: "A practice that grows deliberately",
    body: "We add clinicians and clients at a pace that protects quality of care, with a small team you can actually reach.",
  },
] as const;

const pageTitle = "Therapist Careers | Join TrueBridge in North Carolina";
const pageDescription =
  "TrueBridge is hiring licensed therapists in North Carolina. Join a growing telehealth practice with thoughtful client matching, scheduling support, and low administrative overhead.";

const pageUrl = `${SITE_URL}/careers/`;
const orgId = `${SITE_URL}/#organization`;

const structuredData = [
  {
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    isPartOf: { "@id": `${SITE_URL}/#website` },
    about: { "@id": orgId },
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Careers", item: pageUrl },
    ],
  },
];

const applyMailto = `mailto:${PUBLIC_EMAIL}?subject=${encodeURIComponent("Clinician application")}`;
---

<BaseLayout title={pageTitle} description={pageDescription} structuredData={structuredData}>
  <main id="main">
    <section class="border-b border-line bg-smoke py-16 lg:py-24" aria-labelledby="careers-hero-heading">
      <div class="mx-auto max-w-[1200px] px-5 sm:px-6 lg:px-10">
        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
          <div class="min-w-0 text-left">
            <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-clay">We're hiring</p>
            <h1
              id="careers-hero-heading"
              class="mb-6 font-display text-5xl leading-[1.05] tracking-tight text-ink md:text-6xl"
            >
              Practice therapy the way you trained to.
            </h1>
            <p class="max-w-[660px] text-lg leading-relaxed text-muted md:text-xl">
              TrueBridge is a growing therapy practice serving adults across North Carolina, primarily through
              telehealth. We're looking for licensed clinicians who want well-matched clients, steady support, and less
              administrative weight.
            </p>
            <a
              href={applyMailto}
              class="mt-8 inline-flex items-center justify-center rounded-full bg-sageDark px-7 py-3.5 text-base font-semibold text-paper no-underline transition duration-200 ease-out hover:-translate-y-0.5 hover:brightness-110 hover:text-paper focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-smoke"
            >
              Introduce Yourself
            </a>
          </div>
          <div class="min-w-0">
            <img
              src="/images/careers-hero.jpg"
              alt="A therapist smiles warmly at her laptop in a bright, plant-filled home office during a telehealth session."
              width="1400"
              height="933"
              class="h-[280px] w-full rounded-xl object-cover object-[50%_30%] sm:h-[320px] md:h-[380px] lg:h-[420px]"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <RecognitionGrid
      heading="Why clinicians work with TrueBridge"
      headingId="careers-why-heading"
      intro="We built the practice around the things clinicians told us they wished their last job had."
      items={whyItems}
      columns={3}
    />

    <section class="border-t border-line bg-mist py-14 lg:py-20" aria-labelledby="careers-looking-heading">
      <div class="mx-auto max-w-[900px] px-5 sm:px-6 lg:px-10">
        <h2
          id="careers-looking-heading"
          class="mb-5 font-display text-3xl font-semibold leading-tight tracking-tight text-ink md:text-4xl"
        >
          What we look for
        </h2>
        <p class="text-base leading-relaxed text-muted md:text-lg">
          Clinicians licensed to practice in North Carolina (LCMHC, LCSW, LMFT, or licensed psychologists), with experience
          in our focus areas: anxiety, depression, trauma, stress and burnout, grief, perinatal and postpartum concerns,
          life transitions, or couples work. Comfort delivering engaged therapy over telehealth matters too, since most of
          our sessions happen online.
        </p>
      </div>
    </section>

    <section class="relative border-t border-paper/15 bg-sageDeep py-16 text-center text-paper lg:py-24" aria-labelledby="careers-cta-heading">
      <div class="mx-auto max-w-[860px] px-5 sm:px-6 lg:px-10">
        <h2 id="careers-cta-heading" class="mb-5 font-display text-4xl leading-[1.12] tracking-tight md:text-5xl">
          Interested in joining TrueBridge?
        </h2>
        <p class="mb-8 text-lg leading-relaxed text-paper/90 md:text-xl">
          Email us at
          <a href={applyMailto} class="font-semibold text-paper underline decoration-sage underline-offset-4 hover:decoration-mist"
            >{PUBLIC_EMAIL}</a
          >
          with a short introduction, your licensure, and the clinical work you enjoy most. We'll follow up to talk about
          fit and current openings.
        </p>
        <a
          href={applyMailto}
          class="inline-flex items-center justify-center rounded-full bg-paper px-7 py-3.5 text-base font-semibold text-sageDark no-underline transition hover:-translate-y-0.5 hover:bg-smoke hover:text-sageDark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-sageDeep"
        >
          Email Us About Joining
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
