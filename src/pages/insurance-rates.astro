---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "@/components/patterns/CtaBand.astro";
import RecognitionGrid from "@/components/patterns/RecognitionGrid.astro";

const description =
  "Learn about insurance options, private-pay rates, clinician-specific payment details, and cost expectations before beginning therapy with TrueBridge.";

const costItems = [
  {
    title: "Clinician-specific insurance options",
    body: "Insurance participation may vary by clinician. When clinicians are available, we will help you understand whether a particular clinician accepts your insurance or whether another payment option applies.",
  },
  {
    title: "Private-pay rates",
    body: "Private-pay rates may vary by clinician, service type, and appointment type. Any applicable rate will be reviewed before care begins.",
  },
  {
    title: "Expected out-of-pocket costs",
    body: "Before scheduling ongoing therapy, we aim to help you understand the expected cost based on the clinician, service type, and payment arrangement.",
  },
  {
    title: "Questions before scheduling",
    body: "If you are unsure about insurance, private-pay rates, or which clinician may be the right fit, you can contact us before scheduling a consultation.",
  },
] as const;
---

<BaseLayout title="Insurance & Rates | TrueBridge" {description}>
  <main id="main">
    <!-- Section 1: Hero -->
    <section class="bg-canvas py-16 lg:py-24" aria-labelledby="insurance-rates-heading">
      <div class="mx-auto max-w-[900px] px-5 sm:px-6 lg:px-10 text-left">
        <h1
          id="insurance-rates-heading"
          class="mb-6 font-display text-5xl leading-[1.05] tracking-tight text-ink md:text-6xl"
        >
          Insurance & rates
        </h1>
        <p class="text-lg leading-relaxed text-muted md:text-xl">
          Insurance options and private-pay rates may vary by clinician and service type. Before care begins, we’ll help you understand
          available options, expected costs, and next steps.
        </p>
        <a
          href="/contact-get-started"
          class="mt-8 inline-flex items-center justify-center rounded-full bg-sageDark px-7 py-3.5 text-base font-semibold text-paper no-underline transition duration-200 ease-out hover:-translate-y-0.5 hover:brightness-110 hover:text-paper focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
        >
          Ask About Your Plan
        </a>
      </div>
    </section>

    <!-- Section 2: How insurance and payment work -->
    <RecognitionGrid
      heading="Cost should be clear before care begins."
      headingId="how-payment-heading"
      intro="Therapy is a meaningful investment, and cost questions are a normal part of getting started. Our goal is to help you understand your options before scheduling ongoing care."
      items={costItems}
    />

    <!-- Section 3: Insurance participation by clinician -->
    <section class="bg-mist py-16 lg:py-24" aria-labelledby="participation-heading">
      <div class="mx-auto max-w-[900px] px-5 sm:px-6 lg:px-10">
        <div
          class="rounded-[32px] border border-sand bg-paper p-8 shadow-card md:p-10"
        >
          <h2
            id="participation-heading"
            class="mb-6 font-display text-4xl leading-[1.12] tracking-tight text-ink md:text-5xl"
          >
            Insurance participation may vary by clinician.
          </h2>
          <p class="mb-5 text-lg leading-relaxed text-muted md:text-xl">
            TrueBridge plans to offer insurance-based options as clinician participation and credentialing become available. Because
            insurance participation can vary by clinician, coverage details may depend on the provider you work with.
          </p>
          <p class="text-lg leading-relaxed text-muted md:text-xl">
            Before beginning care, we will help clarify available insurance options, expected out-of-pocket costs, and any next steps needed
            to confirm coverage.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 4: Private-pay rates -->
    <section class="bg-paper py-16 lg:py-24" aria-labelledby="private-pay-heading">
      <div class="mx-auto max-w-[900px] px-5 sm:px-6 lg:px-10">
        <h2
          id="private-pay-heading"
          class="mb-6 font-display text-4xl leading-[1.12] tracking-tight text-ink md:text-5xl"
        >
          Private-pay rates
        </h2>
        <p class="mb-12 text-lg leading-relaxed text-muted md:text-xl">
          If you are paying out of pocket, these are our standard session rates. If insurance applies to your care, your
          out-of-pocket cost depends on your plan, and we will confirm it with you before your first session.
        </p>

        <div
          class="overflow-hidden rounded-[32px] border border-sand bg-smoke shadow-card"
        >
          <div
            class="grid grid-cols-1 items-center gap-2 px-8 py-6 md:grid-cols-[1fr_auto]"
          >
            <p class="font-display text-2xl leading-snug tracking-tight text-ink">Consultation</p>
            <p class="text-lg font-semibold text-ink md:text-xl">Free</p>
          </div>
          <div
            class="grid grid-cols-1 items-center gap-2 border-t border-sand/70 px-8 py-6 md:grid-cols-[1fr_auto]"
          >
            <p class="font-display text-2xl leading-snug tracking-tight text-ink">Individual therapy</p>
            <p class="text-lg font-semibold text-ink md:text-xl">$175 per hour</p>
          </div>
          <div
            class="grid grid-cols-1 items-center gap-2 border-t border-sand/70 px-8 py-6 md:grid-cols-[1fr_auto]"
          >
            <p class="font-display text-2xl leading-snug tracking-tight text-ink">Couples therapy</p>
            <p class="text-lg font-semibold text-ink md:text-xl">$200 per hour</p>
          </div>
        </div>

        <p class="mt-6 text-base leading-relaxed text-muted">
          You will always know your cost before committing to ongoing care. Questions about your specific situation?
          <a
            href="/contact-get-started"
            class="font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors hover:text-sage hover:decoration-sage"
            >Ask us</a
          >, the consultation is free.
        </p>
      </div>
    </section>

    <!-- Section 5: Good Faith Estimate -->
    <section class="bg-smoke py-14 lg:py-20" aria-labelledby="gfe-heading">
      <div class="mx-auto max-w-[900px] px-5 sm:px-6 lg:px-10">
        <h2 id="gfe-heading" class="mb-5 font-display text-3xl leading-tight tracking-tight text-ink md:text-4xl">
          Good Faith Estimate
        </h2>
        <p class="mb-5 text-base leading-relaxed text-muted md:text-lg">
          If you are uninsured or choosing not to use insurance, you may have the right to receive a Good Faith Estimate of expected charges
          before beginning care.
        </p>
        <a
          href="/good-faith-estimate"
          class="font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors hover:text-clay hover:decoration-clay focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sageDark focus-visible:ring-offset-2 focus-visible:ring-offset-smoke"
        >
          Learn more about Good Faith Estimates
        </a>
      </div>
    </section>

    <!-- Section 6: Final CTA -->
    <CtaBand
      heading="Questions about insurance, rates, or next steps?"
      headingId="insurance-cta-heading"
      body="Reach out and we'll help you understand available payment options, clinician fit, and what to expect before beginning care."
      buttonLabel="Contact Us"
    />
  </main>
</BaseLayout>
