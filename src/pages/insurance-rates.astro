---
import BaseLayout from "@/layouts/BaseLayout.astro";

const description =
  "Learn about insurance options, private-pay rates, clinician-specific payment details, and cost expectations before beginning therapy with TrueBridge.";
---

<BaseLayout title="Insurance & Rates | TrueBridge" {description}>
  <main id="main">
    <!-- Section 1: Hero -->
    <section class="bg-canvas py-16 lg:py-24" aria-labelledby="insurance-rates-heading">
      <div class="mx-auto max-w-[900px] px-5 text-left sm:px-6 lg:px-10">
        <h1
          id="insurance-rates-heading"
          class="mb-6 font-display text-5xl leading-[1.05] tracking-tight text-ink md:text-6xl"
        >
          Insurance & rates
        </h1>
        <p class="max-w-[760px] text-lg leading-relaxed text-muted md:text-xl">
          Insurance options and private-pay rates may vary by clinician and service type. Before care begins, we’ll help you understand
          available options, expected costs, and next steps.
        </p>
      </div>
    </section>

    <!-- Section 2: How insurance and payment work -->
    <section class="bg-paper py-16 lg:py-24" aria-labelledby="how-payment-heading">
      <div class="mx-auto max-w-[1200px] px-5 sm:px-6 lg:px-10">
        <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
          <div>
            <h2
              id="how-payment-heading"
              class="mb-6 font-display text-4xl leading-[1.12] tracking-tight text-ink md:text-5xl"
            >
              Cost should be clear before care begins.
            </h2>
            <p class="max-w-[520px] text-lg leading-relaxed text-muted">
              Therapy is a meaningful investment, and cost questions are a normal part of getting started. Our goal is to help you understand
              your options before scheduling ongoing care.
            </p>
          </div>
          <div class="min-w-0">
            <article class="border-t border-sand/70 py-7">
              <h3 class="mb-3 font-display text-2xl leading-snug tracking-tight text-ink">Clinician-specific insurance options</h3>
              <p class="max-w-[680px] text-base leading-relaxed text-muted md:text-lg">
                Insurance participation may vary by clinician. When clinicians are available, we will help you understand whether a particular
                clinician accepts your insurance or whether another payment option applies.
              </p>
            </article>
            <article class="border-t border-sand/70 py-7">
              <h3 class="mb-3 font-display text-2xl leading-snug tracking-tight text-ink">Private-pay rates</h3>
              <p class="max-w-[680px] text-base leading-relaxed text-muted md:text-lg">
                Private-pay rates may vary by clinician, service type, and appointment type. Any applicable rate will be reviewed before care
                begins.
              </p>
            </article>
            <article class="border-t border-sand/70 py-7">
              <h3 class="mb-3 font-display text-2xl leading-snug tracking-tight text-ink">Expected out-of-pocket costs</h3>
              <p class="max-w-[680px] text-base leading-relaxed text-muted md:text-lg">
                Before scheduling ongoing therapy, we aim to help you understand the expected cost based on the clinician, service type, and
                payment arrangement.
              </p>
            </article>
            <article class="border-t border-sand/70 py-7">
              <h3 class="mb-3 font-display text-2xl leading-snug tracking-tight text-ink">Questions before scheduling</h3>
              <p class="max-w-[680px] text-base leading-relaxed text-muted md:text-lg">
                If you are unsure about insurance, private-pay rates, or which clinician may be the right fit, you can contact us before
                scheduling a consultation.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Insurance participation by clinician -->
    <section class="bg-mist py-16 lg:py-24" aria-labelledby="participation-heading">
      <div class="mx-auto max-w-[1000px] px-5 sm:px-6 lg:px-10">
        <div
          class="rounded-[32px] border border-sand bg-paper p-6 shadow-[0_12px_32px_rgba(31,42,48,0.06)] md:p-8"
        >
          <h2
            id="participation-heading"
            class="mb-6 font-display text-4xl leading-[1.12] tracking-tight text-ink md:text-5xl"
          >
            Insurance participation may vary by clinician.
          </h2>
          <p class="mb-5 max-w-[780px] text-lg leading-relaxed text-muted md:text-xl">
            TrueBridge plans to offer insurance-based options as clinician participation and credentialing become available. Because
            insurance participation can vary by clinician, coverage details may depend on the provider you work with.
          </p>
          <p class="max-w-[780px] text-lg leading-relaxed text-muted md:text-xl">
            Before beginning care, we will help clarify available insurance options, expected out-of-pocket costs, and any next steps needed
            to confirm coverage.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 4: Private-pay rates -->
    <section class="bg-paper py-16 lg:py-24" aria-labelledby="private-pay-heading">
      <div class="mx-auto max-w-[1200px] px-5 sm:px-6 lg:px-10">
        <h2
          id="private-pay-heading"
          class="mb-6 font-display text-4xl leading-[1.12] tracking-tight text-ink md:text-5xl"
        >
          Private-pay rates
        </h2>
        <p class="mb-12 max-w-[760px] text-lg leading-relaxed text-muted md:text-xl">
          Private-pay rates may vary by clinician and service type. Rates are confirmed before scheduling ongoing therapy so there are fewer
          surprises.
        </p>

        <div
          class="overflow-hidden rounded-[32px] border border-sand bg-smoke shadow-[0_12px_32px_rgba(31,42,48,0.05)]"
        >
          <div
            class="grid grid-cols-1 items-center gap-2 px-8 py-6 md:grid-cols-[1fr_auto]"
          >
            <p class="font-display text-2xl leading-snug tracking-tight text-ink">Free consultation</p>
            <p class="text-lg font-semibold text-ink md:text-xl">No cost</p>
          </div>
          <div
            class="grid grid-cols-1 items-center gap-2 border-t border-sand/70 px-8 py-6 md:grid-cols-[1fr_auto]"
          >
            <p class="font-display text-2xl leading-snug tracking-tight text-ink">Individual therapy</p>
            <p class="text-lg font-semibold text-ink md:text-xl">Confirmed before care begins</p>
          </div>
          <div
            class="grid grid-cols-1 items-center gap-2 border-t border-sand/70 px-8 py-6 md:grid-cols-[1fr_auto]"
          >
            <p class="font-display text-2xl leading-snug tracking-tight text-ink">Couples therapy</p>
            <p class="text-lg font-semibold text-ink md:text-xl">Confirmed before care begins</p>
          </div>
        </div>

        <p class="mt-6 max-w-[760px] text-base leading-relaxed text-muted">
          Rates may vary by clinician, service type, and payment arrangement. Please confirm current rates before beginning care.
        </p>
      </div>
    </section>

    <!-- Section 5: Good Faith Estimate -->
    <section class="bg-smoke py-14 lg:py-20" aria-labelledby="gfe-heading">
      <div class="mx-auto max-w-[900px] px-5 sm:px-6 lg:px-10">
        <h2 id="gfe-heading" class="mb-5 font-display text-3xl leading-tight tracking-tight text-ink md:text-4xl">
          Good Faith Estimate
        </h2>
        <p class="mb-5 text-base leading-relaxed text-muted md:text-lg">
          If you are uninsured or choosing not to use insurance, you may have the right to receive a Good Faith Estimate of expected charges
          before beginning care.
        </p>
        <a
          href="/good-faith-estimate"
          class="font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors hover:text-clay hover:decoration-clay focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sageDark focus-visible:ring-offset-2 focus-visible:ring-offset-smoke"
        >
          Learn more about Good Faith Estimates
        </a>
      </div>
    </section>

    <!-- Section 6: Final CTA -->
    <section
      class="border-b border-paper/20 bg-sageDark py-16 text-center text-paper lg:py-24"
      aria-labelledby="insurance-cta-heading"
    >
      <div class="mx-auto max-w-[860px] px-5 sm:px-6 lg:px-10">
        <h2 id="insurance-cta-heading" class="mb-5 font-display text-4xl leading-[1.12] tracking-tight md:text-5xl">
          Questions about insurance, rates, or next steps?
        </h2>
        <p class="mb-8 text-lg leading-relaxed text-paper/90 md:text-xl">
          Reach out and we’ll help you understand available payment options, clinician fit, and what to expect before beginning care.
        </p>
        <a
          href="/contact-get-started"
          class="inline-flex items-center justify-center rounded-full bg-paper px-7 py-3.5 text-base font-semibold text-sageDark no-underline transition hover:-translate-y-0.5 hover:bg-smoke hover:text-sageDark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-paper focus-visible:ring-offset-2 focus-visible:ring-offset-sageDark"
        >
          Contact Us
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
