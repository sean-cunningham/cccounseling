---
import BaseLayout from "@/layouts/BaseLayout.astro";

/** Editorial hero photography — local asset in /public/images */
const HERO_IMAGE = "/images/individual-therapy-hero.png";

const faqItems = [
  {
    q: "Do I need to know exactly what I want to work on before starting?",
    a: "No. Many people begin therapy with a general sense that something feels off, overwhelming, or difficult to manage. Your therapist can help clarify goals over time.",
  },
  {
    q: "Is individual therapy only online?",
    a: "No. Most sessions are online through a secure telehealth platform. Depending on scheduling and clinician availability, in-person sessions may sometimes be arranged in the Cary and Raleigh area.",
  },
  {
    q: "Can therapy help if I am dealing with more than one concern?",
    a: "Yes. Many clients come to therapy with overlapping concerns such as anxiety, depression, relationship stress, burnout, trauma, or major life transitions.",
  },
  {
    q: "How do I get matched with a clinician?",
    a: "When you reach out, we help review your needs, preferences, insurance details, and clinician availability so you can begin with a clearer sense of fit.",
  },
] as const;
---

<BaseLayout
  title="Individual Therapy | CC Counseling"
  description="One-on-one therapy for adults across North Carolina — primarily online, with select in-person availability in Cary and Raleigh when scheduling allows — anxiety, depression, stress, trauma, life transitions, relationship patterns, and personal growth."
>
  <main id="main">
    <section class="border-b border-line bg-smoke py-16 lg:py-24" aria-labelledby="individual-hero-heading">
      <div class="mx-auto max-w-site px-5 sm:px-6 lg:px-10">
        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
          <div class="min-w-0">
            <h1
              id="individual-hero-heading"
              class="mb-6 max-w-[720px] font-display text-5xl font-semibold leading-[1.05] tracking-tight text-ink md:text-6xl"
            >
              Individual therapy for when life feels heavier than it should.
            </h1>
            <p class="mb-8 max-w-[660px] text-lg leading-relaxed text-muted md:text-xl">
              One-on-one therapy for adults across North Carolina who want support with anxiety, depression, stress,
              trauma, life transitions, relationship patterns, and personal growth.
            </p>
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-8">
              <a
                href="/contact-get-started"
                class="inline-flex items-center justify-center rounded-full bg-sageDark px-7 py-3.5 text-center text-base font-semibold text-paper no-underline transition duration-200 ease-out hover:-translate-y-0.5 hover:brightness-110 hover:text-paper focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-smoke"
              >
                Start Therapy
              </a>
              <a
                href="/insurance-rates"
                class="text-base font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors hover:text-clay hover:decoration-clay"
              >
                View Insurance &amp; Rates
              </a>
            </div>
          </div>
          <div class="min-w-0">
            <img
              src={HERO_IMAGE}
              alt="A woman sits at a wooden desk with a notebook, looking thoughtfully toward a bright window in a calm, plant-filled room."
              width="1200"
              height="1500"
              class="aspect-[4/3] w-full rounded-[32px] border border-line object-cover shadow-[0_12px_32px_rgba(31,42,48,0.06)] lg:aspect-[4/5]"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-paper py-16 lg:py-24" aria-labelledby="when-help-heading">
      <div class="mx-auto max-w-site px-5 sm:px-6 lg:px-10">
        <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
          <div class="min-w-0">
            <h2
              id="when-help-heading"
              class="mb-6 font-display text-4xl font-semibold leading-[1.12] tracking-tight text-ink md:text-5xl"
            >
              When individual therapy can help
            </h2>
            <p class="max-w-[460px] text-lg leading-relaxed text-muted">
              People often begin therapy when they are tired of carrying things alone, repeating the same patterns, or feeling
              like they should be able to push through but cannot.
            </p>
          </div>
          <div class="min-w-0">
            <article class="border-t border-line py-7">
              <h3 class="mb-3 font-display text-2xl font-semibold text-ink">Anxiety and overthinking</h3>
              <p class="text-base leading-relaxed text-muted md:text-lg">
                Therapy can help you understand worry, panic, avoidance, racing thoughts, and the pressure to stay constantly
                in control.
              </p>
            </article>
            <article class="border-t border-line py-7">
              <h3 class="mb-3 font-display text-2xl font-semibold text-ink">Depression and disconnection</h3>
              <p class="text-base leading-relaxed text-muted md:text-lg">
                Support for low motivation, emotional heaviness, isolation, numbness, and feeling distant from yourself or the
                people around you.
              </p>
            </article>
            <article class="border-t border-line py-7">
              <h3 class="mb-3 font-display text-2xl font-semibold text-ink">Stress, burnout, and life transitions</h3>
              <p class="text-base leading-relaxed text-muted md:text-lg">
                A steady place to process chronic pressure, major changes, grief, parenting stress, career shifts, and seasons
                that feel difficult to navigate.
              </p>
            </article>
            <article class="border-t border-line py-7">
              <h3 class="mb-3 font-display text-2xl font-semibold text-ink">Trauma and painful experiences</h3>
              <p class="text-base leading-relaxed text-muted md:text-lg">
                Therapy can help you work with triggers, nervous system overwhelm, painful memories, and patterns that continue
                to affect daily life.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-sageDark py-16 lg:py-24" aria-labelledby="clinical-band-heading">
      <div class="mx-auto max-w-site px-5 sm:px-6 lg:px-10">
        <h2
          id="clinical-band-heading"
          class="mb-8 max-w-[760px] font-display text-4xl font-semibold leading-[1.12] tracking-tight text-paper md:text-5xl"
        >
          Therapy that is steady, thoughtful, and personal.
        </h2>
        <p class="max-w-[820px] text-lg leading-relaxed text-paper/90 md:text-xl">
          Individual therapy is not about being given a script for your life. It is a space to slow down, understand what is
          happening, and build practical ways of responding to yourself, your relationships, and your circumstances differently.
        </p>
      </div>
    </section>

    <section class="border-t border-line bg-smoke py-16 lg:py-24" aria-labelledby="what-therapy-heading">
      <div class="mx-auto max-w-site px-5 sm:px-6 lg:px-10">
        <h2
          id="what-therapy-heading"
          class="mb-12 font-display text-4xl font-semibold leading-[1.12] tracking-tight text-ink md:text-5xl"
        >
          What individual therapy can help you do
        </h2>
        <div class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-10 lg:gap-16">
          <div class="border-t border-line pt-6">
            <h3 class="mb-3 font-display text-2xl font-semibold text-ink">Understand your patterns</h3>
            <p class="text-base leading-relaxed text-muted md:text-lg">
              Notice the thoughts, emotions, relationship dynamics, and coping strategies that keep showing up.
            </p>
          </div>
          <div class="border-t border-line pt-6">
            <h3 class="mb-3 font-display text-2xl font-semibold text-ink">Build steadier responses</h3>
            <p class="text-base leading-relaxed text-muted md:text-lg">
              Develop practical ways to respond to stress, conflict, anxiety, sadness, and overwhelm with more clarity.
            </p>
          </div>
          <div class="border-t border-line pt-6">
            <h3 class="mb-3 font-display text-2xl font-semibold text-ink">Move with more intention</h3>
            <p class="text-base leading-relaxed text-muted md:text-lg">
              Make choices that better reflect your values, needs, relationships, and the kind of life you want to build.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-canvas py-16 lg:py-24" aria-labelledby="what-to-expect-heading">
      <div class="mx-auto max-w-site px-5 sm:px-6 lg:px-10">
        <h2
          id="what-to-expect-heading"
          class="mb-6 font-display text-4xl font-semibold leading-[1.12] tracking-tight text-ink md:text-5xl"
        >
          What to expect
        </h2>
        <p class="mb-12 max-w-[720px] text-lg leading-relaxed text-muted md:text-xl">
          We keep the first steps clear so you can understand fit, availability, and how insurance may apply before beginning care.
        </p>
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-3 lg:gap-10">
          <article class="border-t border-line pt-6">
            <h3 class="mb-3 font-display text-xl font-semibold text-ink md:text-2xl">Start with a request</h3>
            <p class="text-base leading-relaxed text-muted md:text-lg">
              Tell us what you are looking for and any preferences that matter, including schedule, insurance, and clinician fit.
            </p>
          </article>
          <article class="border-t border-line pt-6">
            <h3 class="mb-3 font-display text-xl font-semibold text-ink md:text-2xl">Review fit and availability</h3>
            <p class="text-base leading-relaxed text-muted md:text-lg">
              Our team helps determine whether we have a clinician whose focus areas and availability match your needs.
            </p>
          </article>
          <article class="border-t border-line pt-6">
            <h3 class="mb-3 font-display text-xl font-semibold text-ink md:text-2xl">Begin therapy</h3>
            <p class="text-base leading-relaxed text-muted md:text-lg">
              If it is a good fit, we help you schedule your first appointment and understand what to expect. Most sessions begin
              online through telehealth; in-person may be discussed when scheduling and location allow.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-mist py-16 lg:py-20" aria-labelledby="insurance-support-heading">
      <div class="mx-auto max-w-site px-5 sm:px-6 lg:px-10">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start lg:gap-16">
          <div class="min-w-0">
            <h2
              id="insurance-support-heading"
              class="mb-6 font-display text-3xl font-semibold leading-[1.12] tracking-tight text-ink md:text-4xl"
            >
              Using insurance for individual therapy
            </h2>
            <p class="max-w-[560px] text-lg leading-relaxed text-muted md:text-xl">
              Before you begin, our team can help you understand whether your insurance may apply with your clinician match,
              expected out-of-pocket costs, and next steps.
            </p>
          </div>
          <div class="flex min-w-0 items-start lg:justify-end lg:pt-1">
            <a
              href="/insurance-rates"
              class="inline-flex items-center justify-center rounded-full bg-sageDark px-7 py-3.5 text-base font-semibold text-paper no-underline transition duration-200 ease-out hover:-translate-y-0.5 hover:brightness-110 hover:text-paper focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-mist"
            >
              Explore Insurance &amp; Rates
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-paper py-16 lg:py-24" aria-labelledby="faq-heading">
      <div class="mx-auto max-w-[900px] px-5 sm:px-6 lg:px-10">
        <h2 id="faq-heading" class="mb-10 font-display text-4xl font-semibold leading-[1.12] tracking-tight text-ink md:text-5xl">
          Individual therapy questions
        </h2>
        <div class="border-b border-line">
          {
            faqItems.map((item) => (
              <details class="group border-t border-line py-5">
                <summary class="cursor-pointer list-none rounded-sm text-lg font-semibold text-ink outline-none [&::-webkit-details-marker]:hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-paper">
                  {item.q}
                </summary>
                <p class="pt-3 text-base leading-relaxed text-muted">{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="relative border-t border-paper/15 bg-sageDeep py-16 text-center lg:py-24" aria-labelledby="final-cta-heading">
      <div class="mx-auto max-w-[860px] px-5 sm:px-6 lg:px-10">
        <h2 id="final-cta-heading" class="font-display text-3xl font-semibold tracking-tight text-paper sm:text-4xl">
          Ready to start individual therapy?
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-paper/88 sm:text-lg">
          Reach out today and we’ll help you understand clinician fit, availability, and how insurance may apply before your
          first appointment.
        </p>
        <a
          href="/contact-get-started"
          class="mt-10 inline-flex items-center justify-center rounded-full bg-paper px-7 py-3.5 text-base font-semibold text-sageDark no-underline transition duration-200 ease-out hover:-translate-y-0.5 hover:bg-smoke focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-sageDeep"
        >
          Get Started
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
