---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "@/components/patterns/CtaBand.astro";
import RecognitionGrid from "@/components/patterns/RecognitionGrid.astro";
import { SITE_URL } from "@/constants/site";

const HERO_IMAGE = "/images/couples-therapy-hero.jpg";

const helpItems = [
  {
    title: "Communication and recurring conflict",
    body: "Therapy can help you slow down heated cycles, name what is happening underneath the argument, and practice ways of listening and responding that feel more respectful and clear.",
  },
  {
    title: "Emotional distance and trust",
    body: "Support when you feel more like roommates than partners, when trust has been strained, or when it is hard to feel emotionally safe together.",
  },
  {
    title: "Life stressors affecting the partnership",
    body: "A steady place to process parenting stress, grief, career demands, moves, family pressure, or transitions that are stretching the relationship.",
  },
  {
    title: "Intimacy and partnership patterns",
    body: "Therapy can help you talk about closeness, boundaries, roles, and expectations with more honesty and less defensiveness.",
  },
] as const;

const pageTitle = "Couples Therapy in North Carolina | TrueBridge";
const pageDescription =
  "Online couples therapy for partners seeking support with communication, conflict, emotional distance, trust concerns, resentments, deepening connection, and rebuilding closeness.";

const orgId = `${SITE_URL}/#organization`;
const pageUrl = `${SITE_URL}/services/couples-therapy/`;

const faqItems = [
  {
    q: "Do we need to be married to start couples therapy?",
    a: "No. Couples therapy is for partners in committed relationships, whether you are married, engaged, dating long-term, or navigating a new chapter together.",
  },
  {
    q: "Is couples therapy only online?",
    a: "No. Most couples sessions use a secure telehealth format. Depending on scheduling and clinician availability, in-person sessions may sometimes be possible in the Cary and Raleigh area.",
  },
  {
    q: "What if we want different things from therapy?",
    a: "That is more common than people expect. Therapy can help you slow down, name what each of you is hoping for, and find workable next steps even when goals do not line up perfectly at first.",
  },
  {
    q: "Does insurance cover couples therapy?",
    a: "Often not directly, and we believe in being upfront about this. Most insurance plans do not cover couples or relationship counseling as its own service. Coverage typically applies only when sessions are billed under one partner's mental health diagnosis and considered medically necessary, and some plans exclude relationship counseling entirely. Many couples choose to pay privately for this reason. Before you begin, we will help you understand what your plan actually covers and what the out-of-pocket cost would be, so there are no surprises.",
  },
  {
    q: "How do we get matched with a clinician?",
    a: "When you reach out together, we review your relationship concerns, preferences, payment options, and availability so you can begin with a clearer sense of clinician fit.",
  },
] as const;

const structuredData = [
  {
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: "Couples Therapy",
    serviceType: "Couples therapy",
    description:
      "Online couples therapy for partners in North Carolina seeking support with communication, conflict, emotional distance, trust concerns, resentments, deepening connection, and rebuilding closeness.",
    provider: { "@id": orgId },
    areaServed: { "@type": "State", name: "North Carolina" },
    url: pageUrl,
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Services", item: `${SITE_URL}/services/` },
      { "@type": "ListItem", position: 3, name: "Couples Therapy", item: pageUrl },
    ],
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription} structuredData={structuredData}>
  <main id="main">
    <section class="border-b border-line bg-smoke py-14 lg:py-20" aria-labelledby="couples-hero-heading">
      <div class="mx-auto max-w-[1200px] px-5 sm:px-6 lg:px-10">
        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
          <div class="min-w-0">
            <h1
              id="couples-hero-heading"
              class="mb-6 max-w-[720px] font-display text-4xl font-semibold leading-[1.08] tracking-tight text-ink md:text-6xl md:leading-[1.05]"
            >
              Couples therapy for when your relationship needs steadier ground.
            </h1>
            <p class="mb-8 max-w-[660px] text-lg leading-relaxed text-muted md:text-xl">
              Therapy for partners across North Carolina who want support with communication, conflict, emotional distance,
              trust concerns, working through resentments, deepening connection, and rebuilding closeness. Most sessions are
              online through telehealth; in the Cary and Raleigh area, in-person may sometimes be possible when scheduling and
              fit allow.
            </p>
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-8">
              <a
                href="/contact-get-started"
                class="inline-flex items-center justify-center rounded-full bg-sageDark px-7 py-3.5 text-center text-base font-semibold text-paper no-underline transition duration-200 ease-out hover:-translate-y-0.5 hover:brightness-110 hover:text-paper focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-smoke"
              >
                Start Therapy
              </a>
              <a
                href="/insurance-rates"
                class="text-base font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors hover:text-sage hover:decoration-sage"
              >
                View Insurance &amp; Rates
              </a>
            </div>
            <p class="mt-4 max-w-[660px] text-sm leading-relaxed text-muted">
              Good to know: most insurance plans don't cover couples therapy as its own service, so sessions are usually
              private-pay ($200 per hour). We'll explain your options and real costs before you begin.
            </p>
          </div>
          <div class="min-w-0">
            <img
              src={HERO_IMAGE}
              alt="A couple sits together on a sofa in a bright, modern room, holding hands in a calm, supportive moment."
              width="1200"
              height="1500"
              class="h-[260px] w-full max-h-[500px] rounded-xl object-cover object-[50%_28%] sm:h-[320px] md:h-[420px] lg:h-[460px]"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <RecognitionGrid
      heading="When couples therapy can help"
      headingId="when-help-heading"
      intro="Partners often begin when conversations feel stuck, resentment is building, or you both want a calmer way to navigate conflict, distance, or a major change together."
      items={helpItems}
    />

    <section class="border-t border-line bg-sageDark py-14 text-paper lg:py-20" aria-labelledby="clinical-band-heading">
      <div class="mx-auto max-w-[1100px] px-5 sm:px-6 lg:px-10">
        <h2
          id="clinical-band-heading"
          class="mb-8 font-display text-4xl font-semibold leading-[1.12] tracking-tight text-paper md:text-5xl"
        >
          Therapy that respects both of you.
        </h2>
        <p class="text-lg leading-relaxed text-paper/90 md:text-xl">
          Couples therapy is not about choosing sides or deciding who is right. It is a structured space to understand patterns,
          reduce unnecessary hurt, and build skills you can use long after the session ends.
        </p>
      </div>
    </section>

    <section class="border-t border-line bg-smoke py-14 lg:py-20" aria-labelledby="what-therapy-heading">
      <div class="mx-auto max-w-[1100px] px-5 sm:px-6 lg:px-10">
        <h2
          id="what-therapy-heading"
          class="mb-12 font-display text-4xl font-semibold leading-[1.12] tracking-tight text-ink md:text-5xl"
        >
          What couples therapy can help you do
        </h2>
        <div class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-10 lg:gap-16">
          <div class="border-t border-line pt-6">
            <h3 class="mb-3 font-display text-2xl font-semibold text-ink">Understand your cycle together</h3>
            <p class="text-base leading-relaxed text-muted md:text-lg">
              Notice the triggers, defenses, and protective moves that show up between you, and what each partner is often
              trying to communicate underneath.
            </p>
          </div>
          <div class="border-t border-line pt-6">
            <h3 class="mb-3 font-display text-2xl font-semibold text-ink">Practice steadier conversations</h3>
            <p class="text-base leading-relaxed text-muted md:text-lg">
              Build tools for repair, boundaries, and difficult topics so disagreements feel less overwhelming and more
              workable.
            </p>
          </div>
          <div class="border-t border-line pt-6">
            <h3 class="mb-3 font-display text-2xl font-semibold text-ink">Move forward with more clarity</h3>
            <p class="text-base leading-relaxed text-muted md:text-lg">
              Decide next steps that reflect your values, your relationship, and the kind of partnership you want to grow
              toward.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-mist py-16 lg:py-24" aria-labelledby="insurance-support-heading">
      <div class="mx-auto max-w-[1100px] px-5 sm:px-6 lg:px-10">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start lg:gap-16">
          <div class="min-w-0">
            <h2
              id="insurance-support-heading"
              class="mb-6 font-display text-3xl font-semibold leading-[1.12] tracking-tight text-ink md:text-4xl"
            >
              An honest word about insurance
            </h2>
            <p class="text-lg leading-relaxed text-muted md:text-xl">
              Most insurance plans do not cover couples therapy as its own service. Coverage usually applies only when
              sessions are billed under one partner's mental health diagnosis, and some plans exclude relationship
              counseling entirely. Many couples pay privately for this reason, at $200 per hour. Before you begin, we will walk through what
              your plan actually covers and what your real costs would be, so you can decide with clear information.
            </p>
          </div>
          <div class="flex min-w-0 items-start lg:justify-end lg:pt-1">
            <a
              href="/insurance-rates"
              class="inline-flex items-center justify-center rounded-full bg-sageDark px-7 py-3.5 text-base font-semibold text-paper no-underline transition duration-200 ease-out hover:-translate-y-0.5 hover:brightness-110 hover:text-paper focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-mist"
            >
              Explore Insurance &amp; Rates
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-paper py-14 lg:py-20" aria-labelledby="faq-heading">
      <div class="mx-auto max-w-[900px] px-5 sm:px-6 lg:px-10">
        <h2 id="faq-heading" class="mb-10 font-display text-4xl font-semibold leading-[1.12] tracking-tight text-ink md:text-5xl">
          Couples therapy questions
        </h2>
        <div class="border-b border-line">
          {
            faqItems.map((item) => (
              <details class="group border-t border-line py-5">
                <summary class="cursor-pointer list-none rounded-sm text-lg font-semibold text-ink outline-none [&::-webkit-details-marker]:hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-paper">
                  {item.q}
                </summary>
                <p class="pt-3 text-base leading-relaxed text-muted">{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <CtaBand
      heading="Ready to start couples therapy?"
      headingId="final-cta-heading"
      body="Reach out together and we'll help you understand clinician fit, availability, and exactly what sessions would cost before your first appointment."
      showPath
    />
  </main>
</BaseLayout>
