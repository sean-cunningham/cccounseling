---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "@/components/patterns/CtaBand.astro";
import RecognitionGrid from "@/components/patterns/RecognitionGrid.astro";
import { FREE_CONSULT_LINE, SITE_URL } from "@/constants/site";
import { SPECIALTIES } from "@/data/specialties";

const IMG_INDIVIDUAL = "/images/services-overview-individual.jpg";
const IMG_COUPLES = "/images/services-overview-couples.jpg";

const servicesTitle = "Therapy Services in North Carolina | TrueBridge";
const servicesDescription =
  "Explore individual therapy, specialty areas of focus, and couples therapy through TrueBridge, with online care for adults across North Carolina.";

const whyItems = [
  {
    title: "Thoughtful clinician matching",
    body: "We help review your needs, preferences, schedule, and goals so you can start with a clinician who is a better fit for what you are looking for.",
  },
  {
    title: "Support before the first appointment",
    body: "Our team helps you understand availability, how insurance may apply with your clinician match, and expected out-of-pocket costs before beginning care.",
  },
  {
    title: "Care that fits your situation",
    body: "You can begin with the type of support that fits, whether the concern feels personal, relational, or both.",
  },
  {
    title: "Flexible care across North Carolina",
    body: "Most sessions are through telehealth, with select in-person options in the Cary and Raleigh area when scheduling and clinician availability allow.",
  },
] as const;

const orgId = `${SITE_URL}/#organization`;
const websiteId = `${SITE_URL}/#website`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${SITE_URL}/services#webpage`,
  url: `${SITE_URL}/services/`,
  name: servicesTitle,
  description: servicesDescription,
  isPartOf: { "@id": websiteId },
  about: { "@id": orgId },
  hasPart: [
    { "@id": `${SITE_URL}/services/individual-therapy/#service` },
    { "@id": `${SITE_URL}/services/couples-therapy/#service` },
    ...SPECIALTIES.map((s) => ({ "@id": `${SITE_URL}/services/${s.slug}/#service` })),
  ],
};

const focusAreas = [
  {
    href: "/services/anxiety-therapy",
    title: "Anxiety and overthinking",
    description: "Support for worry, panic, avoidance, and a mind that will not slow down.",
  },
  {
    href: "/services/depression-therapy",
    title: "Depression and disconnection",
    description: "Care for low mood, lost motivation, emotional heaviness, and isolation.",
  },
  {
    href: "/services/stress-burnout-therapy",
    title: "Stress and burnout",
    description: "Help with chronic pressure, work stress, caregiving strain, and exhaustion.",
  },
  {
    href: "/services/trauma-therapy",
    title: "Trauma and painful experiences",
    description: "Paced support for PTSD, triggers, and experiences that still shape daily life.",
  },
  {
    href: "/services/grief-life-transitions-therapy",
    title: "Grief and life transitions",
    description: "Steady support after loss and through divorce, career change, and new seasons.",
  },
  {
    href: "/services/couples-therapy",
    title: "Relationship concerns",
    description: "Help for communication, conflict, trust, and rebuilding closeness together.",
  },
] as const;
---

<BaseLayout title={servicesTitle} description={servicesDescription} structuredData={structuredData}>
  <main id="main">
    <section class="bg-paper border-b border-line py-16 lg:py-24" aria-labelledby="services-hero-heading">
      <div class="mx-auto max-w-site px-5 sm:px-6 lg:px-10">
        <div class="mx-auto max-w-[860px]">
          <h1
            id="services-hero-heading"
            class="mb-6 font-display text-4xl font-semibold leading-[1.08] tracking-tight text-ink md:text-6xl md:leading-[1.05]"
          >
            Therapy services built around you.
          </h1>
          <p class="max-w-[760px] text-lg leading-relaxed text-muted md:text-xl">
            TrueBridge provides therapy for adults across North Carolina, primarily through telehealth, with thoughtful
            support for anxiety, depression, stress, trauma, grief, relationship concerns, life transitions, and personal
            growth. In the Cary and Raleigh area, in-person may sometimes be possible when scheduling and clinician
            availability allow.
          </p>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-8">
            <a
              href="/contact-get-started"
              class="inline-flex w-fit items-center justify-center rounded-full bg-sageDark px-7 py-3.5 text-center text-base font-semibold text-paper no-underline transition duration-200 ease-out hover:-translate-y-0.5 hover:brightness-110 hover:text-paper focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
            >
              Start Therapy
            </a>
            <a
              href="/insurance-rates"
              class="text-base font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors hover:text-sage hover:decoration-sage"
            >
              View Insurance &amp; Rates
            </a>
          </div>
          <p class="mt-4 text-sm text-muted">{FREE_CONSULT_LINE}</p>
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-canvas py-16 lg:py-24" aria-labelledby="pathways-heading">
      <div class="mx-auto max-w-site px-5 sm:px-6 lg:px-10">
        <h2
          id="pathways-heading"
          class="mb-12 max-w-[760px] font-display text-4xl font-semibold leading-[1.12] tracking-tight text-ink md:text-5xl"
        >
          Choose the support that fits where you are.
        </h2>
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
          <article
            class="overflow-hidden rounded-[32px] border border-line bg-paper shadow-[0_12px_32px_rgba(31,42,48,0.06)] lg:col-span-2"
          >
            <div class="grid grid-cols-1 md:grid-cols-2">
              <img
                src={IMG_INDIVIDUAL}
                alt="A woman tends to indoor plants by a sunlit window in a warm, calm home."
                width="1200"
                height="900"
                class="aspect-[4/3] w-full object-cover object-[50%_30%] md:h-full md:aspect-auto"
                loading="lazy"
              />
              <div class="p-6 lg:p-8">
                <h3 class="mb-4 font-display text-3xl font-semibold leading-[1.08] tracking-tight text-ink md:text-4xl">
                  Individual Therapy
                </h3>
                <p class="mb-6 text-base leading-relaxed text-muted md:text-lg">
                  One-on-one therapy for adults who want support with anxiety, depression, stress, trauma, life transitions,
                  relationships, self-understanding, and personal growth.
                </p>
                <p class="mb-3 text-base font-semibold text-ink">May be a good fit if you want support with:</p>
                <div class="border-t border-line py-3 text-base leading-relaxed text-muted">
                  anxiety, depression, or burnout
                </div>
                <div class="border-t border-line py-3 text-base leading-relaxed text-muted">
                  grief, trauma, or life transitions
                </div>
                <div class="border-t border-line py-3 text-base leading-relaxed text-muted">
                  patterns you want to understand and change
                </div>
                <a
                  href="/services/individual-therapy"
                  class="mt-6 inline-flex text-base font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors duration-200 ease-out hover:text-sage hover:decoration-sage focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
                >
                  Learn about individual therapy
                </a>
              </div>
            </div>
          </article>

          <article
            class="overflow-hidden rounded-[32px] border border-line bg-paper shadow-[0_12px_32px_rgba(31,42,48,0.06)]"
          >
            <img
              src={IMG_COUPLES}
              alt="A couple stands together in a kitchen, sharing a quiet moment while pouring tea."
              width="1200"
              height="900"
              class="aspect-[16/9] w-full object-cover object-[50%_32%]"
              loading="lazy"
            />
            <div class="p-6 lg:p-8">
              <h3 class="mb-4 font-display text-2xl font-semibold leading-[1.08] tracking-tight text-ink md:text-3xl">
                Couples Therapy
              </h3>
              <p class="mb-5 text-base leading-relaxed text-muted">
                Therapy for partners who want help with communication, conflict, emotional distance, trust concerns, and
                rebuilding connection.
              </p>
              <p class="mb-5 text-sm leading-relaxed text-muted">
                Usually private-pay — most insurance plans don't cover couples work, and we'll explain your options before
                you begin.
              </p>
              <a
                href="/services/couples-therapy"
                class="inline-flex text-base font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors duration-200 ease-out hover:text-sage hover:decoration-sage focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
              >
                Learn about couples therapy
              </a>
            </div>
          </article>
        </div>
        <p class="mt-10 text-base leading-relaxed text-muted md:text-lg">
          Not sure which is the right place to begin? <a
            href="/contact-get-started"
            class="font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors hover:text-sage hover:decoration-sage"
            >Reach out</a
          > and we'll help you sort it out — the first consultation is free.
        </p>
      </div>
    </section>

    <RecognitionGrid
      heading="Why TrueBridge"
      headingId="why-cc-heading"
      intro="Starting therapy is easier when the process feels clear, personal, and supported from the beginning."
      items={whyItems}
    />

    <section class="border-t border-line bg-sageDark py-16 text-paper lg:py-24" aria-labelledby="common-reasons-heading">
      <div class="mx-auto max-w-site px-5 sm:px-6 lg:px-10">
        <h2
          id="common-reasons-heading"
          class="mb-6 max-w-[760px] font-display text-4xl font-semibold leading-[1.12] tracking-tight text-paper md:text-5xl"
        >
          Common reasons people reach out
        </h2>
        <p class="mb-14 max-w-[760px] text-lg leading-relaxed text-paper/90 md:text-xl">
          Therapy can be helpful when something feels difficult to carry alone, hard to understand, or stuck in a pattern that
          keeps repeating. Explore how we support each area of focus.
        </p>
        <div class="grid grid-cols-1 gap-0 lg:grid-cols-2 lg:gap-x-16">
          {
            focusAreas.map((area) => (
              <a
                href={area.href}
                class="group block border-t border-paper/25 py-6 no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-sageDark"
              >
                <span class="flex items-baseline justify-between gap-4 font-display text-2xl font-semibold leading-tight tracking-tight text-paper transition-colors group-hover:text-mist md:text-3xl">
                  {area.title}
                  <span aria-hidden="true" class="text-xl transition-transform group-hover:translate-x-1">→</span>
                </span>
                <span class="mt-2 block max-w-[520px] text-base leading-relaxed text-paper/80">{area.description}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <CtaBand
      heading="Ready to find the right fit?"
      headingId="services-final-cta-heading"
      body="Reach out today and we'll help you understand which service may be the best next step."
      showPath
    />
  </main>
</BaseLayout>
