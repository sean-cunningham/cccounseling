---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE_URL, PUBLIC_EMAIL, PUBLIC_PHONE_DISPLAY, PUBLIC_PHONE_E164 } from "@/constants/site";

const description =
  "Contact TrueBridge to schedule a free consultation or ask questions about therapy services, availability, insurance, rates, and next steps.";

const contactLinkClass =
  "font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors hover:text-sage hover:decoration-sage";

const pageTitle = "Contact TrueBridge | Start Therapy in North Carolina";
const orgId = `${SITE_URL}/#organization`;
const websiteId = `${SITE_URL}/#website`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": `${SITE_URL}/contact-get-started/#webpage`,
  url: `${SITE_URL}/contact-get-started/`,
  name: pageTitle,
  description,
  isPartOf: { "@id": websiteId },
  about: { "@id": orgId },
};
---

<BaseLayout title={pageTitle} {description} structuredData={structuredData}>
  <main id="main">
    <section
      class="bg-smoke border-b border-line py-16 lg:py-24"
      aria-labelledby="contact-heading"
    >
      <div class="mx-auto max-w-[1200px] px-5 sm:px-6 lg:px-10">
        <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
          <div>
            <h1
              id="contact-heading"
              class="mb-6 font-display text-5xl leading-[1.05] tracking-tight text-ink md:text-6xl"
            >
              Contact us today
            </h1>
            <p class="mb-10 max-w-[620px] text-lg leading-relaxed text-muted md:text-xl">
              Reach out with questions about fit, availability, insurance, or next steps—or use the secure form to request an appointment.
            </p>

            <div class="rounded-[28px] border border-line bg-paper p-6 shadow-[0_12px_32px_rgba(31,42,48,0.06)]">
              <h2 class="mb-5 font-display text-2xl leading-tight tracking-tight text-ink md:text-3xl">
                Prefer to call or email?
              </h2>
              <div class="border-t border-line py-4">
                <span class="mb-1 block font-semibold text-ink">Phone</span>
                <a href={`tel:${PUBLIC_PHONE_E164}`} class={contactLinkClass}>{PUBLIC_PHONE_DISPLAY}</a>
              </div>
              <div class="border-t border-line py-4">
                <span class="mb-1 block font-semibold text-ink">Email</span>
                <a href={`mailto:${PUBLIC_EMAIL}`} class={contactLinkClass}>{PUBLIC_EMAIL}</a>
              </div>
            </div>
          </div>

          <div class="rounded-[36px] bg-sageDark p-6 text-paper shadow-lift lg:p-8">
            <h2 class="mb-4 font-display text-4xl leading-[1.12] tracking-tight text-paper md:text-5xl">
              Contact us today
            </h2>
            <p class="mb-6 max-w-[620px] text-lg leading-relaxed text-paper/90">
              Share a few details and our team will follow up with next steps.
            </p>

            <iframe
              id="tb-intake-iframe"
              src="/widgets/intake-form-truebridge.html"
              title="Contact TrueBridge — appointment request form"
              class="block w-full border-0"
              style="min-height: 360px; height: 360px;"
              loading="lazy"></iframe>

            <p class="mt-5 text-sm leading-relaxed text-paper/85">
              Please do not include detailed clinical information, diagnosis information, trauma details, or urgent safety concerns in
              the form.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-paper py-8 lg:py-9" aria-label="Privacy and emergency information">
      <div class="mx-auto max-w-[900px] px-5 sm:px-6 lg:px-10">
        <p class="pt-6 text-sm leading-relaxed text-muted md:text-base">
          Please do not include detailed clinical information, diagnosis information, trauma details, or urgent safety concerns in a
          general email or voicemail. This page is not monitored for emergencies. If you are in immediate danger or experiencing a
          mental health crisis, call 988 or 911 or go to the nearest emergency room.
        </p>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      var iframe = document.getElementById("tb-intake-iframe");
      if (!iframe) return;

      var minHeight = 320;
      var maxHeight = 1200;

      function setHeight(px) {
        var h = Math.max(minHeight, Math.min(maxHeight, Math.ceil(px)));
        iframe.style.height = h + "px";
        iframe.style.minHeight = h + "px";
      }

      window.addEventListener("message", function (event) {
        if (!event.data || event.data.source !== "tb-intake-form" || event.data.type !== "resize") {
          return;
        }
        if (typeof event.data.height !== "number" || event.data.height < 1) {
          return;
        }
        setHeight(event.data.height);
      });
    })();
  </script>
</BaseLayout>
