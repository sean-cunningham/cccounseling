---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE_URL, PUBLIC_EMAIL, PUBLIC_PHONE_DISPLAY, PUBLIC_PHONE_E164 } from "@/constants/site";

const description =
  "Contact TrueBridge to schedule a free consultation or ask questions about therapy services, availability, insurance, rates, and next steps.";

const contactLinkClass =
  "font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors hover:text-sage hover:decoration-sage";

const pageTitle = "Contact TrueBridge | Start Therapy in North Carolina";
const orgId = `${SITE_URL}/#organization`;
const websiteId = `${SITE_URL}/#website`;

const iframeSrc =
  "https://admin.truebridgetherapy.com/intake-widget/widgets/intake-form-truebridge.html?mode=formOnly";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": `${SITE_URL}/contact-get-started/#webpage`,
  url: `${SITE_URL}/contact-get-started/`,
  name: pageTitle,
  description,
  isPartOf: { "@id": websiteId },
  about: { "@id": orgId },
};
---

<BaseLayout title={pageTitle} {description} structuredData={structuredData}>
  <main id="main">
    <section
      class="bg-smoke border-b border-line py-12 lg:py-16"
      aria-labelledby="contact-heading"
    >
      <div class="mx-auto max-w-[1200px] px-5 sm:px-6 lg:px-10">
        <div class="flex flex-col gap-8 lg:grid lg:grid-cols-[minmax(0,440px)_minmax(0,1fr)] lg:items-start lg:gap-12">
          <div class="order-1 w-full min-w-0">
            <h1
              id="contact-heading"
              class="mb-4 font-display text-4xl leading-[1.08] tracking-tight text-ink md:text-5xl"
            >
              Contact us today
            </h1>
            <p class="max-w-[620px] text-lg leading-relaxed text-muted">
              Tell us a little about what you're looking for. No need to have it all figured out. We usually reply within
              one business day, and the first consultation is free.
            </p>
          </div>

          <div class="order-2 w-full min-w-0 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:max-w-[660px]">
            <iframe
              id="tb-intake-iframe"
              src={iframeSrc}
              title="Request an appointment"
              class="block w-full border-0"
              style="width: 100%; min-height: 760px; height: 760px; border: 0; display: block;"
              loading="lazy"></iframe>
          </div>

          <div class="order-3 w-full min-w-0 lg:col-start-1">
            <div class="rounded-[28px] border border-line bg-paper p-5 shadow-[0_12px_32px_rgba(31,42,48,0.06)] lg:p-6">
              <h2 class="mb-4 font-display text-2xl leading-tight tracking-tight text-ink">
                Prefer to call or email?
              </h2>
              <div class="border-t border-line py-3">
                <span class="mb-1 block font-semibold text-ink">Phone</span>
                <a href={`tel:${PUBLIC_PHONE_E164}`} class={contactLinkClass}>{PUBLIC_PHONE_DISPLAY}</a>
              </div>
              <div class="border-t border-line py-3">
                <span class="mb-1 block font-semibold text-ink">Email</span>
                <a href={`mailto:${PUBLIC_EMAIL}`} class={contactLinkClass}>{PUBLIC_EMAIL}</a>
              </div>
              <p class="border-t border-line pt-3 text-sm leading-relaxed text-muted">
                We read every message, reply to talk through fit and availability, and help you understand costs before
                anything is scheduled.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-paper py-8 lg:py-9" aria-label="Privacy and emergency information">
      <div class="mx-auto max-w-[900px] px-5 sm:px-6 lg:px-10">
        <p class="pt-6 text-sm leading-relaxed text-muted md:text-base">
          Please do not include detailed clinical information, diagnosis information, trauma details, or urgent safety concerns in a
          general email or voicemail. This page is not monitored for emergencies. If you are in immediate danger or experiencing a
          mental health crisis, call 988 or 911 or go to the nearest emergency room.
        </p>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      var iframe = document.getElementById("tb-intake-iframe");
      if (!iframe) return;

      var trustedOrigin = new URL(iframe.getAttribute("src"), window.location.href).origin;
      var minHeight = 520;
      var maxHeight = 1400;

      function setHeight(px) {
        var h = Math.max(minHeight, Math.min(maxHeight, Math.ceil(px)));
        iframe.style.height = h + "px";
        iframe.style.minHeight = h + "px";
      }

      window.addEventListener("message", function (event) {
        if (event.origin !== trustedOrigin || !event.data || event.data.source !== "tb-intake-form") {
          return;
        }

        if (event.data.type === "resize") {
          if (typeof event.data.height !== "number" || event.data.height < 1) {
            return;
          }
          setHeight(event.data.height);
        }
      });
    })();
  </script>
</BaseLayout>
