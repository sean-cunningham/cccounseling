---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pageTitle = "TrueBridge Blog (Preview) | TrueBridge";
const description =
  "Draft articles about online therapy and insurance in North Carolina. This blog is in review and is not linked from the public site yet.";
---

<BaseLayout title={pageTitle} {description} noindex>
  <main id="main">
    <section class="border-b border-line bg-smoke py-14 lg:py-20" aria-labelledby="blog-heading">
      <div class="mx-auto max-w-[900px] px-5 text-left sm:px-6 lg:px-10">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-sageDark">Internal preview</p>
        <h1
          id="blog-heading"
          class="mb-6 font-display text-5xl leading-[1.05] tracking-tight text-ink md:text-6xl"
        >
          Blog
        </h1>
        <p class="max-w-[760px] text-lg leading-relaxed text-muted md:text-xl">
          These articles are built for review. They are not linked from navigation or the sitemap, and pages are marked
          noindex until you approve launch.
        </p>
      </div>
    </section>

    <section class="bg-paper py-14 lg:py-20" aria-label="Blog articles">
      <div class="mx-auto max-w-[900px] px-5 sm:px-6 lg:px-10">
        <ul class="space-y-8">
          {
            posts.map((post) => (
              <li class="border-b border-line pb-8 last:border-b-0 last:pb-0">
                <p class="mb-2 text-sm text-muted">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                  {post.data.draft ? (
                    <span class="ml-2 rounded-full bg-smoke px-2.5 py-0.5 text-xs font-semibold text-sageDark">
                      Draft
                    </span>
                  ) : null}
                </p>
                <h2 class="mb-3 font-display text-3xl leading-tight tracking-tight text-ink md:text-4xl">
                  <a
                    href={`/blog/${post.id}/`}
                    class="text-ink no-underline decoration-sand underline-offset-4 transition-colors hover:text-sageDark hover:underline"
                  >
                    {post.data.title}
                  </a>
                </h2>
                <p class="max-w-[720px] text-base leading-relaxed text-muted md:text-lg">{post.data.description}</p>
                <a
                  href={`/blog/${post.id}/`}
                  class="mt-4 inline-flex text-base font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors hover:text-sage hover:decoration-sage"
                >
                  Read article
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
