---
import BaseLayout from "@/layouts/BaseLayout.astro";

/** Original full-bleed hero image URL — replace in one place when updating photography. */
const HERO_IMG =
  "https://static.wixstatic.com/media/5ea397_a6fab48af623451487054d8fbe302ed5~mv2.jpg";
const LAPTOP_IMG =
  "https://static.wixstatic.com/media/11062b_4d4cc94a6ee04634abe5e3f340d27c6a~mv2.jpeg";
---

<BaseLayout title="Home | CC Counseling">
  <main id="main">
    <section class="relative isolate w-full min-h-[620px] overflow-x-hidden sm:min-h-[640px] lg:min-h-[720px]" aria-labelledby="hero-heading">
      <div class="absolute inset-0 z-0" aria-hidden="true">
        <img
          src={HERO_IMG}
          alt=""
          width="1920"
          height="1080"
          class="h-full min-h-[620px] w-full object-cover object-center sm:min-h-[640px] lg:min-h-[720px]"
          fetchpriority="high"
        />
      </div>
      <div
        class="pointer-events-none absolute inset-0 z-[1] md:hidden"
        style="background: linear-gradient(90deg, rgba(38, 50, 56, 0.78) 0%, rgba(38, 50, 56, 0.58) 55%, rgba(38, 50, 56, 0.24) 100%);"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-0 z-[1] hidden md:block"
        style="background: linear-gradient(90deg, rgba(38, 50, 56, 0.72) 0%, rgba(38, 50, 56, 0.52) 42%, rgba(38, 50, 56, 0.16) 100%);"
        aria-hidden="true"
      >
      </div>

      <div
        class="relative z-10 mx-auto flex min-h-[620px] w-full max-w-wide items-center px-5 sm:min-h-[640px] sm:px-6 lg:min-h-[720px] lg:px-10 2xl:px-12"
      >
        <div class="w-full max-w-[38.75rem] text-left">
          <h1
            id="hero-heading"
            class="mb-6 font-display text-5xl font-semibold leading-[1.05] tracking-tight text-paper md:text-6xl xl:text-7xl"
          >
            Therapy that helps you feel more like yourself again.
          </h1>
          <p class="mb-8 max-w-[600px] text-lg leading-relaxed text-paper/88 md:text-xl">
            Thoughtful online therapy for adults and couples across North Carolina — with supportive matching, insurance
            guidance, and care that feels human from the first conversation.
          </p>
          <a
            href="/contact-get-started"
            class="inline-flex items-center justify-center rounded-full border-0 bg-paper px-7 py-3.5 text-base font-semibold text-sageDark no-underline transition hover:-translate-y-0.5 hover:bg-sageSoft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-paper"
          >
            Start Therapy
          </a>
        </div>
      </div>
    </section>

    <section class="w-full bg-cream pt-16 lg:pt-24" aria-labelledby="intro-heading">
      <div class="mx-auto max-w-site border-b border-line px-5 pb-16 sm:px-6 lg:px-10 lg:pb-24">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-[0.8fr_1.4fr] lg:items-start lg:gap-16">
          <p class="mt-2 text-sm font-semibold uppercase tracking-[0.18em] text-sageDark">A better first step</p>
          <div class="min-w-0">
            <h2
              id="intro-heading"
              class="mb-6 max-w-[820px] font-display text-4xl font-semibold leading-[1.12] tracking-tight text-ink md:text-5xl"
            >
              Therapy should feel steady, personal, and clear from the beginning.
            </h2>
            <p class="mb-5 max-w-[780px] text-lg leading-relaxed text-muted md:text-xl">
              Whether you are navigating anxiety, relationship stress, depression, burnout, trauma, or a major life
              transition, therapy can give you a steady place to slow down, understand what is happening, and begin moving
              differently.
            </p>
            <p class="max-w-[720px] text-base leading-relaxed text-muted md:text-lg">
              We help match you with a clinician whose approach, availability, and focus areas fit what you are looking for.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-sand/50 bg-paper py-20 lg:py-28" aria-labelledby="steps-heading">
      <div class="mx-auto max-w-site px-5 sm:px-6 lg:px-10">
        <div class="mx-auto mb-10 max-w-[760px] text-center lg:mb-14">
          <h2
            id="steps-heading"
            class="mb-[18px] font-display text-4xl font-semibold leading-[1.12] tracking-tight text-ink md:text-5xl"
          >
            Starting therapy should feel straightforward.
          </h2>
          <p class="mx-auto max-w-[680px] text-lg leading-relaxed text-muted md:text-xl">
            We keep the first steps simple so you can understand fit, availability, and insurance before beginning care.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-3 lg:gap-6">
          <article
            class="flex min-h-[260px] flex-col rounded-[28px] border border-sand/70 bg-cream p-6 text-left shadow-card transition duration-200 ease-out hover:-translate-y-1 hover:border-clay/50 hover:shadow-lift lg:p-8"
          >
            <p class="mb-4 font-sans text-lg font-semibold tabular-nums tracking-[0.06em] text-sageDark">1</p>
            <h3 class="mb-4 font-display text-2xl font-semibold leading-snug tracking-tight text-ink">
              Tell us what you’re looking for.
            </h3>
            <p class="text-base leading-relaxed text-muted">
              Share what brings you to therapy, what kind of support you need, and any preferences that matter for scheduling
              or clinician fit.
            </p>
          </article>
          <article
            class="flex min-h-[260px] flex-col rounded-[28px] border border-sand/70 bg-cream p-6 text-left shadow-card transition duration-200 ease-out hover:-translate-y-1 hover:border-clay/50 hover:shadow-lift lg:p-8"
          >
            <p class="mb-4 font-sans text-lg font-semibold tabular-nums tracking-[0.06em] text-sageDark">2</p>
            <h3 class="mb-4 font-display text-2xl font-semibold leading-snug tracking-tight text-ink">
              We help match you with the right clinician.
            </h3>
            <p class="text-base leading-relaxed text-muted">
              We review availability, clinical focus areas, insurance details, and fit so you are not left guessing where to
              begin.
            </p>
          </article>
          <article
            class="flex min-h-[260px] flex-col rounded-[28px] border border-sand/70 bg-cream p-6 text-left shadow-card transition duration-200 ease-out hover:-translate-y-1 hover:border-clay/50 hover:shadow-lift lg:p-8"
          >
            <p class="mb-4 font-sans text-lg font-semibold tabular-nums tracking-[0.06em] text-sageDark">3</p>
            <h3 class="mb-4 font-display text-2xl font-semibold leading-snug tracking-tight text-ink">
              Begin with a clear next step.
            </h3>
            <p class="text-base leading-relaxed text-muted">
              Once the fit is confirmed, we help you schedule your first appointment and understand what to expect before
              you start.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="bg-sageSoft py-20 lg:py-28" aria-labelledby="focus-heading">
      <div class="mx-auto max-w-site px-5 sm:px-6 lg:px-10">
        <div class="mb-14 max-w-[860px] text-left">
          <h2
            id="focus-heading"
            class="mb-6 font-display text-4xl font-semibold leading-[1.12] tracking-tight text-ink md:text-5xl"
          >
            Areas of clinical focus
          </h2>
          <p class="max-w-[760px] text-lg leading-relaxed text-muted md:text-xl">
            We support adults and couples navigating anxiety, depression, relationship concerns, stress, trauma, and major
            life transitions through thoughtful, evidence-informed therapy.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6 lg:grid-cols-12 lg:gap-6">
          <article
            class="flex min-h-[250px] flex-col justify-between rounded-[32px] border border-sand/70 bg-paper p-8 text-left shadow-[0_12px_32px_rgba(38,50,56,0.05)] md:p-9 lg:col-span-7"
          >
            <h3 class="mb-5 font-display text-3xl font-semibold leading-[1.08] tracking-tight text-ink md:text-4xl">
              Anxiety
            </h3>
            <p class="max-w-[520px] text-base leading-relaxed text-muted md:text-lg">
              Support for worry, overthinking, panic, avoidance, and the constant sense that your mind will not slow down.
            </p>
          </article>
          <article
            class="flex min-h-[250px] flex-col justify-between rounded-[32px] border border-sand/70 bg-cream p-8 text-left shadow-[0_12px_32px_rgba(38,50,56,0.05)] md:p-9 lg:col-span-5"
          >
            <h3 class="mb-5 font-display text-3xl font-semibold leading-[1.08] tracking-tight text-ink md:text-4xl">
              Depression
            </h3>
            <p class="max-w-[520px] text-base leading-relaxed text-muted md:text-lg">
              Care for low mood, loss of motivation, emotional heaviness, isolation, and feeling disconnected from yourself
              or others.
            </p>
          </article>
          <article
            class="flex min-h-[250px] flex-col justify-between rounded-[32px] border border-sand/70 bg-paper p-8 text-left shadow-[0_12px_32px_rgba(38,50,56,0.05)] md:p-9 lg:col-span-5"
          >
            <h3 class="mb-5 font-display text-3xl font-semibold leading-[1.08] tracking-tight text-ink md:text-4xl">
              Relationships
            </h3>
            <p class="max-w-[520px] text-base leading-relaxed text-muted md:text-lg">
              Therapy for communication patterns, conflict, disconnection, trust concerns, and the work of rebuilding
              closeness.
            </p>
          </article>
          <article
            class="flex min-h-[250px] flex-col justify-between rounded-[32px] border border-sand/70 bg-cream p-8 text-left shadow-[0_12px_32px_rgba(38,50,56,0.05)] md:p-9 lg:col-span-7"
          >
            <h3 class="mb-5 font-display text-3xl font-semibold leading-[1.08] tracking-tight text-ink md:text-4xl">
              Stress &amp; burnout
            </h3>
            <p class="max-w-[520px] text-base leading-relaxed text-muted md:text-lg">
              Support for chronic pressure, emotional exhaustion, work stress, caregiving strain, and difficulty feeling
              present in daily life.
            </p>
          </article>
          <article
            class="flex min-h-[250px] flex-col justify-between rounded-[32px] border border-sand/70 bg-paper p-8 text-left shadow-[0_12px_32px_rgba(38,50,56,0.05)] md:p-9 lg:col-span-6"
          >
            <h3 class="mb-5 font-display text-3xl font-semibold leading-[1.08] tracking-tight text-ink md:text-4xl">
              Life transitions
            </h3>
            <p class="max-w-[520px] text-base leading-relaxed text-muted md:text-lg">
              A steady place to process change, including career shifts, parenting, grief, moves, identity questions, and
              new seasons of life.
            </p>
          </article>
          <article
            class="flex min-h-[250px] flex-col justify-between rounded-[32px] border border-sand/70 bg-cream p-8 text-left shadow-[0_12px_32px_rgba(38,50,56,0.05)] md:p-9 lg:col-span-6"
          >
            <h3 class="mb-5 font-display text-3xl font-semibold leading-[1.08] tracking-tight text-ink md:text-4xl">
              Trauma &amp; PTSD
            </h3>
            <p class="max-w-[520px] text-base leading-relaxed text-muted md:text-lg">
              Thoughtful support for painful experiences, nervous system overwhelm, emotional triggers, and patterns that
              continue to affect daily life.
            </p>
          </article>
        </div>
        <p class="mt-10 max-w-[820px] text-base leading-relaxed text-muted md:text-lg">
          We also support clients with grief, self-esteem, anger, OCD, body image concerns, addiction, and other challenges.
        </p>
      </div>
    </section>

    <section class="section-y bg-cream" aria-labelledby="insurance-heading">
      <div
        class="mx-auto grid max-w-site overflow-hidden rounded-[1.75rem] border border-sand bg-paper shadow-soft lg:grid-cols-2"
      >
        <div class="flex flex-col justify-center px-6 py-12 sm:px-10 sm:py-14 lg:px-12 lg:py-16">
          <h2 id="insurance-heading" class="font-display text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
            Using Insurance for Therapy
          </h2>
          <p class="mt-5 text-[0.9375rem] leading-relaxed text-muted">
            Navigating insurance shouldn’t be a barrier to healing. Our administrative team helps you understand the
            specifics of your coverage and out-of-pocket costs before you even begin your first session, ensuring
            transparency and ease from the very start.
          </p>
          <a href="/insurance-rates" class="btn-secondary mt-8 w-fit text-sm"> Explore Insurance &amp; Rates </a>
        </div>
        <div class="relative min-h-[14rem] bg-mist lg:min-h-[20rem]">
          <img
            src={LAPTOP_IMG}
            alt="Laptop on a desk representing telehealth therapy"
            width="1200"
            height="800"
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/20 to-transparent mix-blend-multiply lg:bg-gradient-to-l" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <section
      class="relative overflow-hidden bg-sageDark py-16 text-paper sm:py-20"
      aria-labelledby="cta-title"
    >
      <div
        class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-paper/10 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-32 -left-16 h-72 w-72 rounded-full bg-ink/25 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="section-px relative mx-auto max-w-site text-center">
        <h2 id="cta-title" class="font-display text-3xl font-semibold tracking-tight text-paper sm:text-4xl">
          Ready to get started?
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-paper/90 sm:text-lg">
          Reach out today to begin. We’ll verify your benefits and match you with a clinician who fits your needs and
          schedule across North Carolina.
        </p>
        <a
          href="/contact-get-started"
          class="no-underline mt-10 inline-flex items-center justify-center rounded-full border border-paper/50 bg-transparent px-8 py-3 text-base font-bold text-paper transition duration-200 ease-out hover:-translate-y-0.5 hover:border-clay hover:bg-claySoft hover:text-sageDark hover:shadow-lift focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-paper focus-visible:ring-offset-2 focus-visible:ring-offset-sageDark"
        >
          Get Started
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
