---
import BaseLayout from "@/layouts/BaseLayout.astro";

/** Original full-bleed hero image URL — replace in one place when updating photography. */
const HERO_IMG =
  "https://static.wixstatic.com/media/5ea397_a6fab48af623451487054d8fbe302ed5~mv2.jpg";
const LAPTOP_IMG =
  "https://static.wixstatic.com/media/11062b_4d4cc94a6ee04634abe5e3f340d27c6a~mv2.jpeg";
---

<BaseLayout title="Home | CC Counseling">
  <main id="main">
    <section class="relative isolate w-full min-h-[620px] overflow-x-hidden sm:min-h-[640px] lg:min-h-[720px]" aria-labelledby="hero-heading">
      <div class="absolute inset-0 z-0" aria-hidden="true">
        <img
          src={HERO_IMG}
          alt=""
          width="1920"
          height="1080"
          class="h-full min-h-[620px] w-full object-cover object-center brightness-[0.88] sm:min-h-[640px] lg:min-h-[720px]"
          fetchpriority="high"
        />
      </div>

      <div
        class="relative z-10 mx-auto flex min-h-[620px] w-full max-w-wide items-center px-5 sm:min-h-[640px] sm:px-6 lg:min-h-[720px] lg:px-10 2xl:px-12"
      >
        <div class="w-full max-w-[38.75rem] text-left">
          <h1
            id="hero-heading"
            class="mb-6 font-display text-5xl font-semibold leading-[1.05] tracking-tight text-paper md:text-6xl xl:text-7xl"
          >
            Therapy that helps you feel more like yourself again.
          </h1>
          <p class="mb-8 max-w-[600px] text-lg leading-relaxed text-paper md:text-xl">
            Thoughtful therapy for adults and couples across North Carolina — with most sessions through secure telehealth,
            supportive matching, insurance guidance, and care that feels human from the first conversation. In the Cary and
            Raleigh area, in-person may sometimes be possible when scheduling and fit allow.
          </p>
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-8">
            <a
              href="/contact-get-started"
              class="inline-flex w-fit items-center justify-center rounded-full border-0 bg-paper px-7 py-3.5 text-base font-semibold text-sageDark no-underline transition duration-200 ease-out hover:-translate-y-0.5 hover:bg-sageSoft hover:text-sageDark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-paper"
            >
              Start Therapy
            </a>
            <a
              href="/insurance-rates"
              class="text-base font-semibold text-paper underline decoration-paper/55 underline-offset-4 transition-colors duration-200 ease-out hover:text-paper hover:decoration-paper"
            >
              View Insurance &amp; Rates
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-sand/50 bg-paper py-20 lg:py-28" aria-labelledby="steps-heading">
      <div class="mx-auto max-w-site px-5 sm:px-6 lg:px-10">
        <div class="mx-auto mb-10 max-w-[760px] text-center lg:mb-14">
          <h2
            id="steps-heading"
            class="mb-[18px] font-display text-4xl font-semibold leading-[1.12] tracking-tight text-ink md:text-5xl"
          >
            Starting therapy should feel straightforward.
          </h2>
          <p class="mx-auto max-w-[680px] text-lg leading-relaxed text-muted md:text-xl">
            We keep the first steps simple so you can understand fit, availability, and how insurance may apply before beginning care.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-3 lg:gap-6">
          <article
            class="flex min-h-[260px] flex-col rounded-[28px] border border-sand/70 bg-cream p-6 text-left shadow-card transition duration-200 ease-out hover:-translate-y-0.5 hover:border-clay/45 hover:shadow-soft lg:p-8"
          >
            <p class="mb-4 font-sans text-lg font-semibold tabular-nums tracking-[0.06em] text-clay">1</p>
            <h3 class="mb-4 font-display text-2xl font-semibold leading-snug tracking-tight text-ink">
              Tell us what you’re looking for.
            </h3>
            <p class="text-base leading-relaxed text-muted">
              Share what brings you to therapy, what kind of support you need, and any preferences that matter for scheduling
              or clinician fit.
            </p>
          </article>
          <article
            class="flex min-h-[260px] flex-col rounded-[28px] border border-sand/70 bg-cream p-6 text-left shadow-card transition duration-200 ease-out hover:-translate-y-0.5 hover:border-clay/45 hover:shadow-soft lg:p-8"
          >
            <p class="mb-4 font-sans text-lg font-semibold tabular-nums tracking-[0.06em] text-clay">2</p>
            <h3 class="mb-4 font-display text-2xl font-semibold leading-snug tracking-tight text-ink">
              We help match you with the right clinician.
            </h3>
            <p class="text-base leading-relaxed text-muted">
              We review availability, clinical focus areas, insurance and payment options, and fit so you are not left guessing where to
              begin.
            </p>
          </article>
          <article
            class="flex min-h-[260px] flex-col rounded-[28px] border border-sand/70 bg-cream p-6 text-left shadow-card transition duration-200 ease-out hover:-translate-y-0.5 hover:border-clay/45 hover:shadow-soft lg:p-8"
          >
            <p class="mb-4 font-sans text-lg font-semibold tabular-nums tracking-[0.06em] text-clay">3</p>
            <h3 class="mb-4 font-display text-2xl font-semibold leading-snug tracking-tight text-ink">
              Begin with a clear next step.
            </h3>
            <p class="text-base leading-relaxed text-muted">
              Once the fit is confirmed, we help you schedule your first appointment and understand what to expect before
              you start.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-sageSoft py-20 lg:py-28" aria-labelledby="focus-heading">
      <div class="mx-auto max-w-site px-5 sm:px-6 lg:px-10">
        <div class="mb-16 max-w-[860px] text-left">
          <h2
            id="focus-heading"
            class="mb-6 font-display text-4xl leading-[1.12] tracking-tight text-ink md:text-5xl"
          >
            Areas of clinical focus
          </h2>
          <p class="max-w-[760px] text-lg leading-relaxed text-muted md:text-xl">
            We support adults and couples navigating anxiety, depression, relationship concerns, stress, trauma, and major
            life transitions through thoughtful, evidence-informed therapy.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-y-0 md:grid-cols-2 md:gap-x-16 md:gap-y-0">
          <div class="border-t border-sage/20 py-8 text-left">
            <h3 class="mb-4 font-display text-3xl leading-[1.08] tracking-tight text-ink md:text-4xl">
              Anxiety
            </h3>
            <p class="max-w-[500px] text-base leading-relaxed text-muted md:text-lg">
              Support for worry, overthinking, panic, avoidance, and the constant sense that your mind will not slow down.
            </p>
          </div>
          <div class="border-t border-sage/20 py-8 text-left">
            <h3 class="mb-4 font-display text-3xl leading-[1.08] tracking-tight text-ink md:text-4xl">
              Depression
            </h3>
            <p class="max-w-[500px] text-base leading-relaxed text-muted md:text-lg">
              Care for low mood, loss of motivation, emotional heaviness, isolation, and feeling disconnected from yourself
              or others.
            </p>
          </div>
          <div class="border-t border-sage/20 py-8 text-left">
            <h3 class="mb-4 font-display text-3xl leading-[1.08] tracking-tight text-ink md:text-4xl">
              Relationships
            </h3>
            <p class="max-w-[500px] text-base leading-relaxed text-muted md:text-lg">
              Therapy for communication patterns, conflict, disconnection, trust concerns, and the work of rebuilding closeness.
            </p>
          </div>
          <div class="border-t border-sage/20 py-8 text-left">
            <h3 class="mb-4 font-display text-3xl leading-[1.08] tracking-tight text-ink md:text-4xl">
              Stress &amp; burnout
            </h3>
            <p class="max-w-[500px] text-base leading-relaxed text-muted md:text-lg">
              Support for chronic pressure, emotional exhaustion, work stress, caregiving strain, and difficulty feeling present
              in daily life.
            </p>
          </div>
          <div class="border-t border-sage/20 py-8 text-left">
            <h3 class="mb-4 font-display text-3xl leading-[1.08] tracking-tight text-ink md:text-4xl">
              Life transitions
            </h3>
            <p class="max-w-[500px] text-base leading-relaxed text-muted md:text-lg">
              A steady place to process change, including career shifts, parenting, grief, moves, identity questions, and new
              seasons of life.
            </p>
          </div>
          <div class="border-t border-sage/20 py-8 text-left">
            <h3 class="mb-4 font-display text-3xl leading-[1.08] tracking-tight text-ink md:text-4xl">
              Trauma &amp; PTSD
            </h3>
            <p class="max-w-[500px] text-base leading-relaxed text-muted md:text-lg">
              Thoughtful support for painful experiences, nervous system overwhelm, emotional triggers, and patterns that continue
              to affect daily life.
            </p>
          </div>
        </div>
        <p class="mt-10 max-w-[820px] border-t border-sage/20 pt-8 text-base leading-relaxed text-muted md:text-lg">
          We also support clients with grief, self-esteem, anger, OCD, body image concerns, addiction, and other challenges.
        </p>
      </div>
    </section>

    <section class="bg-paper py-20 lg:py-28" aria-labelledby="insurance-heading">
      <div class="mx-auto max-w-site px-5 sm:px-6 lg:px-10">
        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
          <div class="min-w-0">
            <h2
              id="insurance-heading"
              class="mb-6 font-display text-4xl leading-[1.12] tracking-tight text-ink md:text-5xl"
            >
              Using insurance for therapy
            </h2>
            <p class="mb-8 max-w-[620px] text-lg leading-relaxed text-muted md:text-xl">
              Navigating insurance shouldn’t be a barrier to beginning therapy. When you reach out, we can help you understand
              whether your plan may apply based on the clinician you work with, along with expected out-of-pocket costs before
              your first session, so you can start with more clarity and fewer surprises.
            </p>
            <a
              href="/insurance-rates"
              class="inline-flex items-center rounded-full bg-sageDark px-7 py-3.5 font-semibold text-paper no-underline transition hover:-translate-y-0.5 hover:bg-sage hover:text-paper focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
            >
              Explore Insurance &amp; Rates
            </a>
          </div>
          <div class="min-w-0">
            <img
              src={LAPTOP_IMG}
              alt="Laptop on a desk, suggesting flexible therapy including online sessions"
              width="1200"
              height="800"
              class="aspect-[4/3] w-full rounded-[32px] border border-sand/70 object-cover shadow-soft"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="relative bg-ink py-16 text-paper sm:py-20" aria-labelledby="cta-title">
      <div class="section-px relative mx-auto max-w-site text-center">
        <h2 id="cta-title" class="font-display text-3xl font-semibold tracking-tight text-paper sm:text-4xl">
          Ready to get started?
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-paper/75 sm:text-lg">
          Reach out today to begin. We can help you understand how insurance may apply with your clinician match, then connect
          you with someone who fits your needs and schedule across North Carolina.
        </p>
        <a
          href="/contact-get-started"
          class="no-underline mt-10 inline-flex items-center justify-center rounded-full border-0 bg-paper px-8 py-3 text-base font-bold text-sageDark transition duration-200 ease-out hover:-translate-y-0.5 hover:bg-sageSoft hover:text-sageDark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-paper focus-visible:ring-offset-2 focus-visible:ring-offset-ink"
        >
          Get Started
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
