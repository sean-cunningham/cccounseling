---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "@/components/patterns/CtaBand.astro";
import { FREE_CONSULT_LINE, SITE_URL, SITE_NAME, PUBLIC_PHONE_E164, PUBLIC_EMAIL } from "@/constants/site";

/** Full-bleed hero image — replace in one place when updating photography. */
const HERO_IMG = "/images/home-hero.jpg";
const LAPTOP_IMG = "/images/online-therapy-laptop.jpg";

const homeTitle = "Online Therapy in North Carolina | TrueBridge";
const homeDescription =
  "TrueBridge provides online therapy for adults across North Carolina, with support for anxiety, depression, stress, trauma, grief, relationships, and life transitions.";

const orgId = `${SITE_URL}/#organization`;
const websiteId = `${SITE_URL}/#website`;
const webpageId = `${SITE_URL}/#webpage`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalBusiness",
      "@id": orgId,
      name: SITE_NAME,
      url: SITE_URL,
      description: "Online therapy for adults across North Carolina.",
      areaServed: { "@type": "State", name: "North Carolina" },
      medicalSpecialty: ["MentalHealth", "Psychotherapy"],
      telephone: PUBLIC_PHONE_E164,
      email: PUBLIC_EMAIL,
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: SITE_URL,
      name: SITE_NAME,
      publisher: { "@id": orgId },
    },
    {
      "@type": "WebPage",
      "@id": webpageId,
      url: SITE_URL,
      name: homeTitle,
      description: homeDescription,
      isPartOf: { "@id": websiteId },
      about: { "@id": orgId },
    },
  ],
};

const focusAreas = [
  {
    href: "/services/anxiety-therapy",
    title: "Anxiety",
    description:
      "Support for worry, overthinking, panic, avoidance, and the constant sense that your mind will not slow down.",
    linkLabel: "Explore anxiety therapy",
  },
  {
    href: "/services/depression-therapy",
    title: "Depression",
    description:
      "Care for low mood, loss of motivation, emotional heaviness, isolation, and feeling disconnected from yourself or others.",
    linkLabel: "Explore depression therapy",
  },
  {
    href: "/services/couples-therapy",
    title: "Relationships",
    description:
      "Therapy for communication patterns, conflict, disconnection, trust concerns, and the work of rebuilding closeness.",
    linkLabel: "Explore couples therapy",
  },
  {
    href: "/services/stress-burnout-therapy",
    title: "Stress & burnout",
    description:
      "Support for chronic pressure, emotional exhaustion, work stress, caregiving strain, and difficulty feeling present in daily life.",
    linkLabel: "Explore stress & burnout therapy",
  },
  {
    href: "/services/grief-life-transitions-therapy",
    title: "Life transitions",
    description:
      "A steady place to process change, including career shifts, parenting, grief, moves, identity questions, and new seasons of life.",
    linkLabel: "Explore grief & life transitions therapy",
  },
  {
    href: "/services/perinatal-postpartum-therapy",
    title: "Perinatal & postpartum",
    description:
      "Support for women through perinatal and infant loss, infertility, postpartum changes, and the hormonal and identity shifts of motherhood.",
    linkLabel: "Explore perinatal & postpartum therapy",
  },
  {
    href: "/services/trauma-therapy",
    title: "Trauma & PTSD",
    description:
      "Thoughtful support for painful experiences, nervous system overwhelm, emotional triggers, and patterns that continue to affect daily life.",
    linkLabel: "Explore trauma therapy",
  },
] as const;
---

<BaseLayout title={homeTitle} description={homeDescription} structuredData={structuredData}>
  <main id="main">
    <section class="relative isolate w-full min-h-[620px] overflow-x-hidden sm:min-h-[640px] lg:min-h-[720px]" aria-labelledby="hero-heading">
      <div class="absolute inset-0 z-0" aria-hidden="true">
        <img
          src={HERO_IMG}
          alt=""
          width="1920"
          height="1080"
          class="h-full min-h-[620px] w-full object-cover object-center sm:min-h-[640px] lg:min-h-[720px]"
          fetchpriority="high"
        />
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-r from-ink/92 via-ink/62 to-ink/18"
          aria-hidden="true"
        ></div>
      </div>

      <div
        class="relative z-10 mx-auto flex min-h-[620px] w-full max-w-wide items-center px-5 sm:min-h-[640px] sm:px-6 lg:min-h-[720px] lg:px-10 2xl:px-12"
      >
        <div class="w-full max-w-[38.75rem] text-left">
          <h1
            id="hero-heading"
            class="mb-6 font-display text-5xl font-semibold leading-[1.05] tracking-tight text-paper [text-shadow:0_1px_2px_rgba(31,42,48,0.28),0_0_18px_rgba(31,42,48,0.12)] md:text-6xl xl:text-7xl"
          >
            Therapy for meaningful, lasting change
          </h1>
          <p class="mb-8 max-w-[600px] text-lg leading-relaxed text-paper [text-shadow:0_1px_2px_rgba(31,42,48,0.26),0_0_16px_rgba(31,42,48,0.14)] md:text-xl">
            Thoughtful, grounded therapy for adults across North Carolina, designed to help you better understand
            yourself, navigate challenges with clarity, and create positive lasting change.
          </p>
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-8">
            <a
              href="/contact-get-started"
              class="inline-flex w-fit items-center justify-center rounded-full bg-sageDark px-7 py-3.5 text-base font-semibold text-paper no-underline transition duration-200 ease-out hover:-translate-y-0.5 hover:brightness-110 hover:text-paper focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-ink/75"
            >
              Start Therapy
            </a>
            <a
              href="/insurance-rates"
              class="text-base font-semibold text-paper underline decoration-sage underline-offset-4 transition-colors duration-200 ease-out hover:text-paper hover:decoration-mist"
            >
              View Insurance &amp; Rates
            </a>
          </div>
          <p class="mt-4 text-sm text-paper/90 [text-shadow:0_1px_2px_rgba(31,42,48,0.26)]">{FREE_CONSULT_LINE}</p>
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-paper py-20 lg:py-28" aria-labelledby="steps-heading">
      <div class="mx-auto max-w-site px-5 sm:px-6 lg:px-10">
        <div class="mx-auto mb-10 max-w-[760px] text-center lg:mb-14">
          <h2
            id="steps-heading"
            class="mb-[18px] font-display text-4xl font-semibold leading-[1.12] tracking-tight text-ink md:text-5xl"
          >
            Starting therapy should feel straightforward.
          </h2>
          <p class="mx-auto max-w-[680px] text-lg leading-relaxed text-muted md:text-xl">
            We keep the first steps simple so you can understand fit, availability, and how insurance may apply before beginning care.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-3 lg:gap-6">
          <article
            class="flex min-h-[260px] flex-col rounded-[28px] border border-line bg-smoke p-6 text-left shadow-[0_12px_32px_rgba(31,42,48,0.06)] transition duration-200 ease-out hover:-translate-y-0.5 hover:border-ink/25 hover:shadow-soft lg:p-8"
          >
            <p class="mb-4 font-sans text-lg font-semibold tabular-nums tracking-[0.06em] text-sageDark">1</p>
            <h3 class="mb-4 font-display text-2xl font-semibold leading-snug tracking-tight text-ink">
              Tell us what you’re looking for.
            </h3>
            <p class="text-base leading-relaxed text-muted">
              Share what brings you to therapy, what kind of support you need, and any preferences that matter for scheduling
              or clinician fit.
            </p>
          </article>
          <article
            class="flex min-h-[260px] flex-col rounded-[28px] border border-line bg-smoke p-6 text-left shadow-[0_12px_32px_rgba(31,42,48,0.06)] transition duration-200 ease-out hover:-translate-y-0.5 hover:border-ink/25 hover:shadow-soft lg:p-8"
          >
            <p class="mb-4 font-sans text-lg font-semibold tabular-nums tracking-[0.06em] text-sageDark">2</p>
            <h3 class="mb-4 font-display text-2xl font-semibold leading-snug tracking-tight text-ink">
              We help match you with the right clinician.
            </h3>
            <p class="text-base leading-relaxed text-muted">
              We review availability, clinical focus areas, insurance and payment options, and fit so you are not left guessing where to
              begin.
            </p>
          </article>
          <article
            class="flex min-h-[260px] flex-col rounded-[28px] border border-line bg-smoke p-6 text-left shadow-[0_12px_32px_rgba(31,42,48,0.06)] transition duration-200 ease-out hover:-translate-y-0.5 hover:border-ink/25 hover:shadow-soft lg:p-8"
          >
            <p class="mb-4 font-sans text-lg font-semibold tabular-nums tracking-[0.06em] text-sageDark">3</p>
            <h3 class="mb-4 font-display text-2xl font-semibold leading-snug tracking-tight text-ink">
              Begin with a clear next step.
            </h3>
            <p class="text-base leading-relaxed text-muted">
              Once the fit is confirmed, we help you schedule your first appointment and understand what to expect before
              you start.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-sageDark py-20 text-paper lg:py-28" aria-labelledby="focus-heading">
      <div class="mx-auto max-w-site px-5 sm:px-6 lg:px-10">
        <div class="mb-10 max-w-[860px] text-left">
          <h2
            id="focus-heading"
            class="mb-6 font-display text-4xl leading-[1.12] tracking-tight text-paper md:text-5xl"
          >
            Areas of clinical focus
          </h2>
          <p class="max-w-[760px] text-lg leading-relaxed text-paper/90 md:text-xl">
            We support adults navigating anxiety, depression, relationship concerns, stress, trauma, and major
            life transitions through thoughtful, evidence-informed therapy.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
          {
            focusAreas.map((area) => (
              <a
                href={area.href}
                class="group block rounded-[24px] border border-paper/20 bg-paper/10 p-6 text-left no-underline transition duration-200 ease-out hover:-translate-y-0.5 hover:border-paper/40 hover:bg-paper/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-sageDark"
              >
                <span class="flex items-baseline justify-between gap-3 font-display text-xl font-semibold leading-snug tracking-tight text-paper">
                  {area.title}
                  <span aria-hidden="true" class="text-lg transition-transform group-hover:translate-x-1">→</span>
                </span>
                <span class="mt-2 block text-sm leading-relaxed text-paper/85">{area.description}</span>
              </a>
            ))
          }
        </div>
        <p class="mt-10 max-w-[820px] border-t border-paper/25 pt-8 text-base leading-relaxed text-paper/90 md:text-lg">
          We also support clients with grief, self-esteem, anger, OCD, body image concerns, addiction, and other challenges.
        </p>
      </div>
    </section>

    <section class="border-t border-line bg-mist py-20 lg:py-28" aria-labelledby="insurance-heading">
      <div class="mx-auto max-w-site px-5 sm:px-6 lg:px-10">
        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
          <div class="min-w-0">
            <h2
              id="insurance-heading"
              class="mb-6 font-display text-4xl leading-[1.12] tracking-tight text-ink md:text-5xl"
            >
              Using insurance for therapy
            </h2>
            <p class="mb-8 max-w-[620px] text-lg leading-relaxed text-muted md:text-xl">
              Cost shouldn't be a mystery. TrueBridge is completing insurance credentialing, and participation varies by
              clinician — so when you reach out, we'll tell you plainly what your plan can and can't cover, and exactly what
              your out-of-pocket cost would be, before your first session. No surprises, starting with a free consultation.
            </p>
            <a
              href="/insurance-rates"
              class="inline-flex items-center rounded-full bg-sageDark px-7 py-3.5 font-semibold text-paper no-underline transition hover:-translate-y-0.5 hover:brightness-110 hover:text-paper focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-mist"
            >
              Explore Insurance &amp; Rates
            </a>
          </div>
          <div class="min-w-0">
            <img
              src={LAPTOP_IMG}
              alt="Laptop on a desk, suggesting flexible therapy including online sessions"
              width="1200"
              height="800"
              class="aspect-[4/3] w-full rounded-[32px] border border-line object-cover shadow-[0_12px_32px_rgba(31,42,48,0.06)]"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <CtaBand
      heading="Ready to get started?"
      headingId="cta-title"
      body="Reach out today to begin. We'll help you understand how insurance may apply with your clinician match, then connect you with someone who fits your needs and schedule across North Carolina."
    />
  </main>
</BaseLayout>
