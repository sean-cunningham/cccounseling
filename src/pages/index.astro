---
import BaseLayout from "@/layouts/BaseLayout.astro";

/** Original full-bleed hero image URL — replace in one place when updating photography. */
const HERO_IMG =
  "https://static.wixstatic.com/media/5ea397_a6fab48af623451487054d8fbe302ed5~mv2.jpg";
const LAPTOP_IMG =
  "https://static.wixstatic.com/media/11062b_4d4cc94a6ee04634abe5e3f340d27c6a~mv2.jpeg";

const focusAreas = [
  {
    title: "Anxiety",
    body: "Silence the persistent noise of worry to rediscover a grounded sense of daily peace.",
  },
  {
    title: "Depression",
    body: "Move through the heavy weight of sadness with professional guidance rooted in healing.",
  },
  {
    title: "Relationships",
    body: "Work through disagreements and build healthy patterns of communication and trust.",
  },
  {
    title: "Stress & Burnout",
    body: "Restore your vitality when professional and life demands begin to feel overwhelming.",
  },
  {
    title: "Life Transitions",
    body: "Step through major updates, from career shifts to moving, with stability and insight.",
  },
  {
    title: "Trauma & PTSD",
    body: "Process your past in a compassionate space dedicated to your wellness and inner safety.",
  },
] as const;
---

<BaseLayout title="Home | CC Counseling">
  <main id="main">
    <section class="relative isolate w-full min-h-[620px] overflow-x-hidden sm:min-h-[640px] lg:min-h-[720px]" aria-labelledby="hero-heading">
      <div class="absolute inset-0 z-0" aria-hidden="true">
        <img
          src={HERO_IMG}
          alt=""
          width="1920"
          height="1080"
          class="h-full min-h-[620px] w-full object-cover object-center sm:min-h-[640px] lg:min-h-[720px]"
          fetchpriority="high"
        />
      </div>
      <div
        class="pointer-events-none absolute inset-0 z-[1] md:hidden"
        style="background: linear-gradient(90deg, rgba(38, 50, 56, 0.78) 0%, rgba(38, 50, 56, 0.58) 55%, rgba(38, 50, 56, 0.24) 100%);"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-0 z-[1] hidden md:block"
        style="background: linear-gradient(90deg, rgba(38, 50, 56, 0.72) 0%, rgba(38, 50, 56, 0.52) 42%, rgba(38, 50, 56, 0.16) 100%);"
        aria-hidden="true"
      >
      </div>

      <div
        class="relative z-10 mx-auto flex min-h-[620px] w-full max-w-wide items-center px-5 sm:min-h-[640px] sm:px-6 lg:min-h-[720px] lg:px-10 2xl:px-12"
      >
        <div class="w-full max-w-[38.75rem] text-left">
          <h1
            id="hero-heading"
            class="mb-6 font-display text-5xl font-semibold leading-[1.05] tracking-tight text-paper md:text-6xl xl:text-7xl"
          >
            Therapy that helps you feel more like yourself again.
          </h1>
          <p class="mb-8 max-w-[600px] text-lg leading-relaxed text-paper/88 md:text-xl">
            Thoughtful online therapy for adults and couples across North Carolina — with supportive matching, insurance
            guidance, and care that feels human from the first conversation.
          </p>
          <a
            href="/contact-get-started"
            class="inline-flex items-center justify-center rounded-full border-0 bg-paper px-7 py-3.5 text-base font-semibold text-sageDark no-underline transition hover:-translate-y-0.5 hover:bg-sageSoft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-paper"
          >
            Start Therapy
          </a>
        </div>
      </div>
    </section>

    <section class="w-full bg-cream pt-16 lg:pt-24" aria-labelledby="intro-heading">
      <div class="mx-auto max-w-site border-b border-line px-5 pb-16 sm:px-6 lg:px-10 lg:pb-24">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-[0.8fr_1.4fr] lg:items-start lg:gap-16">
          <p class="mt-2 text-sm font-semibold uppercase tracking-[0.18em] text-sageDark">A better first step</p>
          <div class="min-w-0">
            <h2
              id="intro-heading"
              class="mb-6 max-w-[820px] font-display text-4xl font-semibold leading-[1.12] tracking-tight text-ink md:text-5xl"
            >
              Therapy should feel steady, personal, and clear from the beginning.
            </h2>
            <p class="mb-5 max-w-[780px] text-lg leading-relaxed text-muted md:text-xl">
              Whether you are navigating anxiety, relationship stress, depression, burnout, trauma, or a major life
              transition, therapy can give you a steady place to slow down, understand what is happening, and begin moving
              differently.
            </p>
            <p class="max-w-[720px] text-base leading-relaxed text-muted md:text-lg">
              We help match you with a clinician whose approach, availability, and focus areas fit what you are looking for.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section-y relative bg-cream" aria-labelledby="steps-heading">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-line to-transparent" aria-hidden="true"></div>
      <div class="section-px mx-auto max-w-site">
        <h2 id="steps-heading" class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-[2rem]">
          Getting Started is Simple
        </h2>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
          Reaching out for therapy can feel like a lot. We keep the process clear, supportive, and straightforward from
          the beginning.
        </p>
        <div class="mt-10 h-px w-24 bg-sage/70" aria-hidden="true"></div>
        <div class="mt-12 grid gap-6 sm:grid-cols-3">
          <article
            class="group relative rounded-[1.75rem] border border-sand bg-paper p-8 shadow-card transition duration-300 ease-out hover:-translate-y-1 hover:border-clay/35 hover:shadow-lift"
          >
            <span class="font-display text-sm font-semibold text-sageDark">01</span>
            <h3 class="mt-3 font-display text-xl font-semibold leading-snug text-ink">Start the Conversation</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              Tell us what brings you in, what kind of support you’re looking for, and any preferences you have for care.
            </p>
          </article>
          <article
            class="group relative rounded-[1.75rem] border border-sand bg-paper p-8 shadow-card transition duration-300 ease-out hover:-translate-y-1 hover:border-clay/35 hover:shadow-lift"
          >
            <span class="font-display text-sm font-semibold text-sageDark">02</span>
            <h3 class="mt-3 font-display text-xl font-semibold leading-snug text-ink">Insurance and Matching</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              We’ll review your coverage and match you with a clinician whose approach and availability fit your needs.
            </p>
          </article>
          <article
            class="group relative rounded-[1.75rem] border border-sand bg-paper p-8 shadow-card transition duration-300 ease-out hover:-translate-y-1 hover:border-clay/35 hover:shadow-lift"
          >
            <span class="font-display text-sm font-semibold text-sageDark">03</span>
            <h3 class="mt-3 font-display text-xl font-semibold leading-snug text-ink">Schedule your first session</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              Once you’re matched, we’ll help you get your first appointment on the calendar so you can begin with a clear
              next step.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section-y border-y border-line bg-mist/60" aria-labelledby="focus-heading">
      <div class="section-px mx-auto max-w-site">
        <h2 id="focus-heading" class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-[2rem]">
          Areas of Clinical Focus
        </h2>
        <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">
          We provide specialized care for a wide range of mental health concerns, supporting your journey with
          high-quality clinical expertise and a human-centered approach.
        </p>
        <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            focusAreas.map((item) => (
              <article class="rounded-[1.75rem] border border-sand bg-paper p-7 shadow-card transition duration-200 hover:-translate-y-1 hover:border-clay/35 hover:shadow-lift">
                <div class="h-0.5 w-10 rounded-full bg-sage" aria-hidden="true" />
                <h3 class="mt-5 font-display text-xl font-semibold leading-snug text-ink">{item.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>
              </article>
            ))
          }
        </div>
        <p class="mt-12 max-w-3xl text-[0.9375rem] leading-relaxed text-muted">
          We also support clients with many other challenges, including grief, self-esteem, anger, OCD, body image,
          addiction, and more. If you’re not sure whether we’re the right fit, reach out and we’ll happily discuss how we
          can help you create meaningful, lasting change.
        </p>
      </div>
    </section>

    <section class="section-y bg-cream" aria-labelledby="insurance-heading">
      <div
        class="mx-auto grid max-w-site overflow-hidden rounded-[1.75rem] border border-sand bg-paper shadow-soft lg:grid-cols-2"
      >
        <div class="flex flex-col justify-center px-6 py-12 sm:px-10 sm:py-14 lg:px-12 lg:py-16">
          <h2 id="insurance-heading" class="font-display text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
            Using Insurance for Therapy
          </h2>
          <p class="mt-5 text-[0.9375rem] leading-relaxed text-muted">
            Navigating insurance shouldn’t be a barrier to healing. Our administrative team helps you understand the
            specifics of your coverage and out-of-pocket costs before you even begin your first session, ensuring
            transparency and ease from the very start.
          </p>
          <a href="/insurance-rates" class="btn-secondary mt-8 w-fit text-sm"> Explore Insurance &amp; Rates </a>
        </div>
        <div class="relative min-h-[14rem] bg-mist lg:min-h-[20rem]">
          <img
            src={LAPTOP_IMG}
            alt="Laptop on a desk representing telehealth therapy"
            width="1200"
            height="800"
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/20 to-transparent mix-blend-multiply lg:bg-gradient-to-l" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <section
      class="relative overflow-hidden bg-sageDark py-16 text-paper sm:py-20"
      aria-labelledby="cta-title"
    >
      <div
        class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-paper/10 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-32 -left-16 h-72 w-72 rounded-full bg-ink/25 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="section-px relative mx-auto max-w-site text-center">
        <h2 id="cta-title" class="font-display text-3xl font-semibold tracking-tight text-paper sm:text-4xl">
          Ready to get started?
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-paper/90 sm:text-lg">
          Reach out today to begin. We’ll verify your benefits and match you with a clinician who fits your needs and
          schedule across North Carolina.
        </p>
        <a
          href="/contact-get-started"
          class="no-underline mt-10 inline-flex items-center justify-center rounded-full border border-paper/50 bg-transparent px-8 py-3 text-base font-bold text-paper transition duration-200 ease-out hover:-translate-y-0.5 hover:border-clay hover:bg-claySoft hover:text-sageDark hover:shadow-lift focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-paper focus-visible:ring-offset-2 focus-visible:ring-offset-sageDark"
        >
          Get Started
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
