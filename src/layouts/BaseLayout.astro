---
import "../styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_NAME } from "@/constants/site";

/** JSON-LD: single document, @graph object, or array of nodes (wrapped with @context + @graph). */
export type StructuredDataProp = Record<string, unknown> | Record<string, unknown>[] | undefined;

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** When true, asks search engines not to index (e.g. 404). */
  noindex?: boolean;
  structuredData?: StructuredDataProp;
}

const {
  title,
  description = "Thoughtful, grounded therapy for individuals and couples across North Carolina.",
  ogImage = "https://static.wixstatic.com/media/5ea397_a6fab48af623451487054d8fbe302ed5~mv2.jpg",
  noindex = false,
  structuredData,
} = Astro.props;

const site = Astro.site ?? new URL("https://cccounseling.com");
const canonical = new URL(Astro.url.pathname, site);
const ogImageAbsolute =
  ogImage.startsWith("http://") || ogImage.startsWith("https://")
    ? ogImage
    : new URL(ogImage.startsWith("/") ? ogImage : `/${ogImage}`, site).href;

let structuredDataJson: string | null = null;
if (structuredData !== undefined && structuredData !== null) {
  const payload = Array.isArray(structuredData)
    ? { "@context": "https://schema.org", "@graph": structuredData }
    : structuredData;
  structuredDataJson = JSON.stringify(payload);
}
---

<!doctype html>
<html lang="en" class="font-sans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1F2A30" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="https://static.wixstatic.com/media/2e2a49_ab2e08c188f248779ab3728026123e34~mv2.png"
      type="image/png"
    />
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
  </head>
  <body class="flex min-h-dvh flex-col bg-canvas">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[200] focus:rounded-md focus:bg-paper focus:px-4 focus:py-2 focus:text-ink focus:shadow-soft focus:outline-none focus:ring-2 focus:ring-sageDark focus:ring-offset-2 focus:ring-offset-canvas"
      >Skip to main content</a
    >
    <Header currentPath={Astro.url.pathname} />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
  </body>
</html>
