---
import "../styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_NAME } from "@/constants/site";

/** JSON-LD: single document, @graph object, or array of nodes (wrapped with @context + @graph). */
export type StructuredDataProp = Record<string, unknown> | Record<string, unknown>[] | undefined;

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** When true, asks search engines not to index (e.g. 404). */
  noindex?: boolean;
  structuredData?: StructuredDataProp;
}

const {
  title,
  description = "Thoughtful, grounded therapy for adults across North Carolina.",
  ogImage = "/images/og-default.jpg",
  noindex = false,
  structuredData,
} = Astro.props;

const googleFontsHref =
  "https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";

const site = Astro.site ?? new URL("https://truebridgetherapy.com");
const canonical = new URL(Astro.url.pathname, site);
const gaMeasurementId = import.meta.env.NEXT_PUBLIC_GA_MEASUREMENT_ID?.trim() ?? "";
const gaEnabled = Boolean(gaMeasurementId);
/**
 * Full-site deploys on Vercel default to noindex (preview + production *.vercel.app)
 * while the public domain may be coming-soon on AWS.
 * Opt out with PUBLIC_ALLOW_VERCEL_INDEXING=true on Vercel only (rare).
 */
const onVercel =
  process.env.VERCEL === "1" ||
  (typeof process.env.VERCEL_ENV === "string" && process.env.VERCEL_ENV.length > 0);
const allowIndexOnVercel = import.meta.env.PUBLIC_ALLOW_VERCEL_INDEXING === "true";
const vercelDefaultNoindex = onVercel && !allowIndexOnVercel;
const noindexRobots =
  noindex || import.meta.env.PUBLIC_NOINDEX === "true" || vercelDefaultNoindex;
const ogImageAbsolute =
  ogImage.startsWith("http://") || ogImage.startsWith("https://")
    ? ogImage
    : new URL(ogImage.startsWith("/") ? ogImage : `/${ogImage}`, site).href;

let structuredDataJson: string | null = null;
if (structuredData !== undefined && structuredData !== null) {
  const payload = Array.isArray(structuredData)
    ? { "@context": "https://schema.org", "@graph": structuredData }
    : structuredData;
  structuredDataJson = JSON.stringify(payload);
}
---

<!doctype html>
<html lang="en" class="font-sans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindexRobots ? "noindex, nofollow" : "index, follow"} />
    <meta name="theme-color" content="#1F2A30" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={googleFontsHref} rel="stylesheet" />
    <link rel="icon" href="/images/favicon.png" type="image/png" sizes="any" />
    <link rel="apple-touch-icon" href="/images/favicon.png" />
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
    {
      gaEnabled && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
          <script is:inline define:vars={{ gaMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", gaMeasurementId, {
              send_page_view: true,
            });
          </script>
        </>
      )
    }
  </head>
  <body class="flex min-h-dvh flex-col bg-canvas">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[200] focus:rounded-md focus:bg-paper focus:px-4 focus:py-2 focus:text-ink focus:shadow-soft focus:outline-none focus:ring-2 focus:ring-sageDark focus:ring-offset-2 focus:ring-offset-canvas"
      >Skip to main content</a
    >
    <Header currentPath={Astro.url.pathname} />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
    {
      gaEnabled && (
        <script is:inline>
          (function () {
            document.addEventListener(
              "click",
              function (e) {
                var t = e.target;
                if (!t || !t.closest) return;
                var el = t.closest("a[href]");
                if (!el) return;
                var href = el.getAttribute("href");
                if (!href) return;
                if (href.indexOf("tel:") === 0) {
                  gtag("event", "phone_click");
                  return;
                }
                if (href.indexOf("mailto:") === 0) {
                  gtag("event", "email_click");
                  return;
                }
                try {
                  var u = new URL(href, window.location.origin);
                  if (
                    u.pathname === "/contact-get-started" ||
                    u.pathname.indexOf("/contact-get-started/") === 0
                  ) {
                    gtag("event", "get_started_click");
                  }
                } catch (err) {
                  void err;
                }
              },
              true,
            );
          })();
        </script>
      )
    }
  </body>
</html>
