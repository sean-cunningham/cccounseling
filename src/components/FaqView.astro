---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "@/components/patterns/CtaBand.astro";

const description =
  "Answers about online therapy in North Carolina, insurance, rates, clinician matching, individual therapy, and couples therapy at TrueBridge.";

type FaqItem = { q: string; a: string; aHtml?: boolean };

function faqAnswerPlain(htmlOrText: string): string {
  return htmlOrText
    .replace(/<[^>]*>/g, " ")
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/\s+/g, " ")
    .trim();
}

const groups: { title: string; items: FaqItem[] }[] = [
  {
    title: "Getting started",
    items: [
      {
        q: "How do I start therapy with TrueBridge?",
        a: '<p>You can start by submitting a request through our <a href="/contact-get-started" class="font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors hover:text-sage hover:decoration-sage">Get Started</a> page. The first consultation is free, and we’ll review what you are looking for, discuss fit and availability, and help you understand the next step before scheduling your first appointment.</p>',
        aHtml: true,
      },
      {
        q: "Do I need to know exactly what I want to work on?",
        a: "No. Many people begin therapy with a general sense that something feels off, overwhelming, or difficult to manage. Your therapist can help you clarify goals as the work develops.",
      },
      {
        q: "How do you match clients with clinicians?",
        a: "We consider your concerns, preferences, schedule, availability, and the clinician’s focus areas. The goal is to help you begin with a clearer sense of fit rather than leaving you to sort through everything alone.",
      },
    ],
  },
  {
    title: "Services and fit",
    items: [
      {
        q: "Do you offer individual therapy?",
        a: '<p>Yes. TrueBridge offers <a href="/services/individual-therapy" class="font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors hover:text-sage hover:decoration-sage">individual therapy</a> for adults across North Carolina, primarily through telehealth. Individual therapy may be a good fit for anxiety, depression, stress, trauma, grief, life transitions, relationship patterns, self-esteem, and personal growth. Depending on scheduling and clinician availability, in-person sessions may sometimes be possible in the Cary and Raleigh area.</p>',
        aHtml: true,
      },
      {
        q: "Do you offer couples therapy?",
        a: '<p>Yes. <a href="/services/couples-therapy" class="font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors hover:text-sage hover:decoration-sage">Couples therapy</a> can help partners work through communication issues, recurring conflict, emotional distance, trust concerns, life transitions, and rebuilding connection. Most sessions are online. One honest note: most insurance plans do not cover couples therapy as its own service, so sessions are usually private-pay. We’ll explain your options and costs before you begin.</p>',
        aHtml: true,
      },
      {
        q: "What if I’m not sure whether I need individual therapy or couples therapy?",
        a: "That is common. If the concern feels mostly personal, individual therapy may be the right place to begin. If the concern is mainly happening between you and your partner, couples therapy may be a better fit. We can help you think through the best next step.",
      },
    ],
  },
  {
    title: "Insurance and payment",
    items: [
      {
        q: "Do you accept insurance?",
        a: '<p>Whether insurance can be used depends on the clinician you work with and the health plans that clinician participates in. Before you begin, we can help you understand whether your plan may apply and what your estimated costs could look like. See <a href="/insurance-rates" class="font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors hover:text-sage hover:decoration-sage">Insurance &amp; Rates</a> for details.</p>',
        aHtml: true,
      },
      {
        q: "Will you verify my insurance benefits?",
        a: "When you are matched with a clinician who participates with your plan, we help you understand benefits and expected out-of-pocket costs before the first session whenever possible.",
      },
      {
        q: "What if my insurance is not accepted?",
        a: "If your insurance does not apply to your care we will explain payment options and expected costs before you begin so you can make an informed decision.",
      },
      {
        q: "Where can I find rates and insurance information?",
        a: '<p>You can visit the <a href="/insurance-rates" class="font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors hover:text-sage hover:decoration-sage">Insurance &amp; Rates</a> page for an overview. What applies to you still depends on the clinician you see and your plan. Ask when you reach out and we can help you think it through.</p>',
        aHtml: true,
      },
    ],
  },
  {
    title: "Sessions and format",
    items: [
      {
        q: "How are therapy sessions usually held?",
        a: "Most sessions take place online through a secure telehealth platform. Depending on scheduling and clinician availability, in-person sessions may be possible in the Cary and Raleigh area. We can talk through what fits when you reach out.",
      },
      {
        q: "Can therapy be effective online?",
        a: "Many clients find online therapy helpful, convenient, and easier to fit into their lives. Much of what makes therapy useful like rapport, consistency, and a setting that feels private matters whether you meet online or in person. Fit depends on your needs, preferences, and the type of support you are looking for.",
      },
      {
        q: "Do I need to be in North Carolina?",
        a: "Yes. Therapy services are available to clients located in North Carolina.",
      },
    ],
  },
  {
    title: "Clinicians and care",
    items: [
      {
        q: "Who will I work with?",
        a: '<p>We match you with a clinician who works with TrueBridge based on fit, focus area, schedule, and availability. You can meet the team on our <a href="/clinicians" class="font-semibold text-sageDark underline decoration-sand underline-offset-4 transition-colors hover:text-sage hover:decoration-sage">Clinicians</a> page.</p>',
        aHtml: true,
      },
      {
        q: "Are clinicians licensed?",
        a: "Clinicians providing therapy through TrueBridge are expected to hold appropriate professional licensure or authorization to provide therapy services in North Carolina.",
      },
      {
        q: "Can I choose my clinician?",
        a: "You can share preferences when you reach out. Availability may vary, but we will do our best to consider fit, clinical needs, schedule, and preferences.",
      },
    ],
  },
];

const faqMainEntity = groups.flatMap((group) =>
  group.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.aHtml ? faqAnswerPlain(item.a) : item.a,
    },
  })),
);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqMainEntity,
};
---

<BaseLayout title="FAQ: Online Therapy in North Carolina | TrueBridge" {description} structuredData={structuredData}>
  <main id="main">
    <section class="border-b border-line bg-smoke py-16 lg:py-24" aria-labelledby="faq-hero-heading">
      <div class="mx-auto max-w-[900px] px-5 text-left sm:px-6 lg:px-10">
        <h1
          id="faq-hero-heading"
          class="mb-6 font-display text-5xl leading-[1.05] tracking-tight text-ink md:text-6xl"
        >
          Frequently asked questions
        </h1>
        <p class="max-w-[760px] text-lg leading-relaxed text-muted md:text-xl">
          Answers to common questions about starting therapy, finding the right fit, using insurance, and what to expect from
          care, including how sessions are typically held.
        </p>
      </div>
    </section>

    <section class="border-t border-line bg-paper py-16 lg:py-24" aria-label="Questions by topic">
      <div class="mx-auto max-w-[900px] px-5 sm:px-6 lg:px-10">
        {
          groups.map((group, groupIndex) => (
            <section aria-labelledby={`faq-group-${groupIndex}-heading`}>
              <h2
                id={`faq-group-${groupIndex}-heading`}
                class:list={[
                  "mb-6 font-display text-3xl leading-tight tracking-tight text-ink md:text-4xl",
                  groupIndex > 0 && "mt-14",
                ]}
              >
                {group.title}
              </h2>
              <div>
                {group.items.map((item) => (
                  <details class="group border-t border-line py-5">
                    <summary class="flex w-full cursor-pointer list-none items-start justify-between gap-6 text-left text-lg font-semibold leading-snug text-ink outline-none [&::-webkit-details-marker]:hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay md:text-xl">
                      <span class="min-w-0 flex-1">{item.q}</span>
                      <span
                        class="shrink-0 select-none tabular-nums text-sageDark group-open:hidden"
                        aria-hidden="true"
                      >
                        +
                      </span>
                      <span
                        class="hidden shrink-0 select-none tabular-nums text-sageDark group-open:inline"
                        aria-hidden="true"
                      >
                        −
                      </span>
                    </summary>
                    <div class="max-w-[760px] pt-4 text-base leading-relaxed text-muted md:text-lg">
                      {item.aHtml ? (
                        <div set:html={item.a} />
                      ) : (
                        <p>{item.a}</p>
                      )}
                    </div>
                  </details>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <CtaBand
      heading="Still have questions?"
      headingId="faq-final-cta-heading"
      body="Reach out and we'll help you understand services, fit, availability, and next steps before beginning care."
    />
  </main>
</BaseLayout>
