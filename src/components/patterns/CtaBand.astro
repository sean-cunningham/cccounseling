---
/**
 * Closing CTA band — one per page, always with the free-consultation line
 * and licensure trust line. Optionally carries the Path Strip so the 3-step
 * story doesn't need its own section.
 */
import PathStrip from "@/components/patterns/PathStrip.astro";
import { FREE_CONSULT_LINE, TRUST_LINE } from "@/constants/site";

interface Props {
  heading: string;
  headingId: string;
  body?: string;
  buttonLabel?: string;
  href?: string;
  showPath?: boolean;
}

const { heading, headingId, body, buttonLabel = "Get Started", href = "/contact-get-started", showPath = false } = Astro.props;
---

<section class="relative border-t border-paper/15 bg-sageDeep py-14 text-center text-paper lg:py-20" aria-labelledby={headingId}>
  <div class="mx-auto max-w-[900px] px-5 sm:px-6 lg:px-10">
    {
      showPath && (
        <div class="mb-12 border-b border-paper/20 pb-10">
          <PathStrip tone="dark" />
        </div>
      )
    }
    <h2 id={headingId} class="font-display text-3xl font-semibold tracking-tight text-paper sm:text-4xl">{heading}</h2>
    {body && <p class="mx-auto mt-5 max-w-[680px] text-base leading-relaxed text-paper/90 sm:text-lg">{body}</p>}
    <a
      href={href}
      class="mt-9 inline-flex items-center justify-center rounded-full bg-paper px-7 py-3.5 text-base font-semibold text-sageDark no-underline transition duration-200 ease-out hover:-translate-y-0.5 hover:bg-smoke hover:text-sageDark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-sageDeep"
    >
      {buttonLabel}
    </a>
    <p class="mt-4 text-sm text-paper/85">{FREE_CONSULT_LINE}</p>
    <p class="mt-7 text-xs font-semibold uppercase tracking-wider text-paper/60">{TRUST_LINE}</p>
  </div>
</section>
