<!-- TODO: Remove temporary theme toggle before launch. -->
<button
  id="theme-toggle"
  type="button"
  class="fixed bottom-4 right-4 z-[9999] rounded-full border border-paper/20 bg-ink px-4 py-2 text-sm font-semibold text-paper shadow-lg transition hover:-translate-y-0.5 hover:bg-sageDark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay"
  aria-label="Toggle color theme"
>
  Theme: Warm
</button>

<script is:inline>
  (() => {
    const STORAGE_KEY = "cc-theme";

    const getTheme = () => {
      const current = document.documentElement.dataset.theme;
      if (current === "cool" || current === "warm") return current;
      return "warm";
    };

    const setTheme = (theme) => {
      const nextTheme = theme === "cool" ? "cool" : "warm";
      document.documentElement.dataset.theme = nextTheme;

      try {
        localStorage.setItem(STORAGE_KEY, nextTheme);
      } catch {}

      const button = document.getElementById("theme-toggle");
      if (button) {
        button.textContent = nextTheme === "cool" ? "Theme: Cool" : "Theme: Warm";
      }
    };

    const init = () => {
      let savedTheme = "warm";
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored === "cool" || stored === "warm") savedTheme = stored;
      } catch {}

      setTheme(savedTheme);

      const button = document.getElementById("theme-toggle");
      if (!button) return;

      button.addEventListener("click", () => {
        const current = getTheme();
        setTheme(current === "cool" ? "warm" : "cool");
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
