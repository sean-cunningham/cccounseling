---
const LOGO =
  "https://static.wixstatic.com/media/2e2a49_ab2e08c188f248779ab3728026123e34~mv2.png";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const nav = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services", children: [{ href: "/individual-therapy", label: "Individual Therapy" }] },
  { href: "/clinicians", label: "Our Clinicians" },
  { href: "/insurance-rates", label: "Insurance & Rates" },
  { href: "/faq-1", label: "FAQ" },
] as const;

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/" || currentPath === "";
  return currentPath === href || currentPath.startsWith(href + "/");
}
---

<header
  class="sticky top-0 z-[100] border-b border-sand bg-paper/90 shadow-sm backdrop-blur-md backdrop-saturate-150 transition-shadow duration-300 ease-out"
>
  <input type="checkbox" id="nav-check" class="peer sr-only" aria-hidden="true" />
  <div class="section-px mx-auto flex max-w-site items-center justify-between gap-6 py-3.5">
    <a href="/" class="shrink-0 transition-opacity hover:opacity-90" aria-label="CC Counseling home">
      <img src={LOGO} width="499" height="191" alt="CC Counseling" class="h-10 w-auto sm:h-11" />
    </a>
    <label
      for="nav-check"
      class="flex cursor-pointer items-center justify-center rounded-lg p-2 text-ink hover:bg-sageSoft/80 lg:hidden"
      aria-label="Toggle menu"
    >
      <svg width="26" height="18" viewBox="0 0 200 200" aria-hidden="true" class="text-ink">
        <path fill="currentColor" d="M156 64v6H44v-6h112z"></path>
        <path fill="currentColor" d="M156 97v6H44v-6h112z"></path>
        <path fill="currentColor" d="M156 130v6H44v-6h112z"></path>
      </svg>
    </label>
    <div class="hidden items-center gap-2 lg:flex lg:flex-1 lg:justify-end">
      <nav class="flex flex-wrap items-center gap-0.5 pr-2" aria-label="Primary">
        {
          nav.map((item, i) => (
            <>
              {i > 0 && <span class="mx-0.5 h-3.5 w-px bg-line" aria-hidden="true" />}
              {"children" in item && item.children ? (
                <div class="group relative">
                  <a
                    href={item.href}
                    class:list={[
                      "inline-flex items-center gap-1 rounded-md px-2.5 py-1.5 text-[0.9375rem] font-medium text-ink no-underline transition-colors hover:bg-sageSoft/80 hover:text-sageDark",
                      isActive(item.href) && "text-sageDark",
                    ]}
                  >
                    {item.label}
                    <span
                      class="border-x-4 border-x-transparent border-t-[5px] border-t-ink/50 opacity-80"
                      aria-hidden="true"
                    />
                  </a>
                  <div
                    class="invisible absolute left-0 top-full z-50 mt-1 min-w-[14rem] origin-top scale-95 rounded-xl border border-sand bg-paper py-1 opacity-0 shadow-nav transition-all duration-200 ease-out group-hover:visible group-hover:scale-100 group-hover:opacity-100"
                    role="menu"
                  >
                    {item.children.map((c) => (
                      <a
                        href={c.href}
                        class:list={[
                          "block px-4 py-2.5 text-sm text-ink/90 no-underline transition-colors hover:bg-sageSoft hover:text-clay",
                          isActive(c.href) && "bg-sageSoft/60 text-sageDark",
                        ]}
                        role="menuitem"
                      >
                        {c.label}
                      </a>
                    ))}
                  </div>
                </div>
              ) : (
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "rounded-md px-2.5 py-1.5 text-[0.9375rem] font-medium no-underline transition-colors hover:bg-sageSoft/80 hover:text-sageDark",
                    isActive(item.href) ? "text-sageDark" : "text-ink",
                  ]}
                >
                  {item.label}
                </a>
              )}
            </>
          ))
        }
      </nav>
      <a href="/contact-get-started" class="btn-primary shrink-0 text-[0.9375rem]">Get Started</a>
    </div>
  </div>
  <div
    class="max-h-0 overflow-hidden border-t border-sand bg-paper transition-[max-height] duration-300 ease-out peer-checked:max-h-[28rem] lg:hidden"
  >
    <nav class="section-px flex flex-col gap-0.5 py-4" aria-label="Mobile">
      {
        nav.map((item) =>
          "children" in item && item.children ? (
            <div class="border-b border-line py-2 last:border-0">
              <a href={item.href} class="font-medium text-ink no-underline hover:text-sageDark">
                {item.label}
              </a>
              <div class="mt-2 flex flex-col gap-1 pl-3">
                {item.children.map((c) => (
                  <a href={c.href} class="text-sm text-muted no-underline hover:text-clay">
                    {c.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="rounded-md py-2.5 font-medium text-ink no-underline hover:bg-sageSoft/50 hover:text-sageDark"
            >
              {item.label}
            </a>
          ),
        )
      }
      <a href="/contact-get-started" class="btn-primary mt-3 w-full text-center">Get Started</a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var peer = document.getElementById("nav-check");
    if (!peer) return;
    document.querySelectorAll('header nav[aria-label="Mobile"] a').forEach(function (a) {
      a.addEventListener("click", function () {
        peer.checked = false;
      });
    });
  })();
</script>
