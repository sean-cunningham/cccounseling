---
const LOGO =
  "https://static.wixstatic.com/media/2e2a49_ab2e08c188f248779ab3728026123e34~mv2.png";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const serviceItems = [
  {
    href: "/services/individual-therapy",
    title: "Individual Therapy",
    description: "Support for anxiety, stress, depression, life transitions, and personal growth.",
  },
  {
    href: "/services/couples-therapy",
    title: "Couples Therapy",
    description: "Help for communication, disconnection, conflict, and rebuilding closeness.",
  },
] as const;

const navRest = [
  { href: "/clinicians", label: "Our Clinicians" },
  { href: "/insurance-rates", label: "Insurance & Rates" },
  { href: "/faq-1", label: "FAQ" },
] as const;

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/" || currentPath === "";
  return currentPath === href || currentPath.startsWith(href + "/");
}

const servicesActive = isActive("/services");
---

<header
  class="sticky top-0 z-[100] border-b border-sand/60 bg-paper/90 backdrop-blur-md"
>
  <div
    class="mx-auto flex min-h-[76px] w-full max-w-wide items-center justify-between gap-4 px-5 py-4 sm:px-6 lg:px-10 2xl:px-12"
  >
    <a href="/" class="shrink-0 transition-opacity hover:opacity-90" aria-label="CC Counseling home">
      <img src={LOGO} width="499" height="191" alt="CC Counseling" class="h-10 w-auto lg:h-12" />
    </a>

    <button
      type="button"
      id="header-nav-toggle"
      class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-sand bg-paper text-ink transition-colors hover:bg-sageSoft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 focus-visible:ring-offset-paper lg:ml-auto lg:hidden"
      aria-controls="header-mobile-drawer"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <svg width="22" height="16" viewBox="0 0 200 200" aria-hidden="true" class="text-ink">
        <path fill="currentColor" d="M156 64v6H44v-6h112z"></path>
        <path fill="currentColor" d="M156 97v6H44v-6h112z"></path>
        <path fill="currentColor" d="M156 130v6H44v-6h112z"></path>
      </svg>
    </button>

    <div class="hidden min-w-0 flex-1 items-center justify-end gap-10 pl-6 xl:pl-10 2xl:pl-14 lg:flex">
      <nav class="flex min-w-0 flex-wrap items-center justify-end gap-8" aria-label="Primary">
        <a
          href="/"
          aria-current={isActive("/") ? "page" : undefined}
          class:list={[
            "border-b-2 border-transparent pb-0.5 text-[0.95rem] font-medium no-underline transition-colors",
            isActive("/") ? "text-sageDark border-sageDark" : "text-ink/80 hover:text-sageDark",
          ]}
        >
          Home
        </a>

        <div class="header-svc-wrap relative flex shrink-0 items-center gap-1.5">
          <a
            href="/services"
            aria-current={servicesActive ? "page" : undefined}
            class:list={[
              "border-b-2 border-transparent pb-0.5 text-[0.95rem] font-medium no-underline transition-colors",
              servicesActive ? "text-sageDark border-sageDark" : "text-ink/80 hover:text-sageDark",
            ]}
          >
            Services
          </a>
          <button
            type="button"
            id="header-svc-btn"
            class="header-svc-btn -m-1 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-ink/70 transition-colors hover:bg-sageSoft hover:text-sageDark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="header-svc-flyout"
            aria-label="Services submenu"
          >
            <svg width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true" class="translate-y-px">
              <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <div
            id="header-svc-flyout"
            class="header-svc-flyout absolute left-0 top-full z-50 min-w-[17.5rem] w-[min(22rem,calc(100vw-2rem))] max-w-[calc(100vw-2.5rem)] origin-top pt-2.5"
            role="menu"
            aria-label="Services"
          >
            <div class="rounded-2xl border border-sand/70 bg-paper p-3.5 shadow-soft">
              {
                serviceItems.map((item) => (
                  <a
                    href={item.href}
                    role="menuitem"
                    class:list={[
                      "group/svcitem mb-1.5 block rounded-xl px-3 py-3 no-underline transition-colors last:mb-0 hover:bg-sageSoft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 focus-visible:ring-offset-paper",
                      isActive(item.href) && "bg-sageSoft/70",
                    ]}
                  >
                    <span class="block text-[0.95rem] font-semibold text-sageDark">
                      {item.title}
                    </span>
                    <span class="mt-0.5 block text-xs font-normal leading-snug text-muted">{item.description}</span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        {
          navRest.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "border-b-2 border-transparent pb-0.5 text-[0.95rem] font-medium no-underline transition-colors",
                isActive(item.href) ? "text-sageDark border-sageDark" : "text-ink/80 hover:text-sageDark",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <a
        href="/contact-get-started"
        class="inline-flex shrink-0 items-center justify-center rounded-full bg-sageDark px-6 py-2.5 text-[0.95rem] font-semibold text-paper no-underline transition-colors duration-200 ease-out hover:bg-sage hover:text-paper focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
      >
        Get Started
      </a>
    </div>
  </div>

  <div
    id="header-mobile-drawer"
    class="hidden border-t border-sand/70 bg-paper lg:hidden"
    role="dialog"
    aria-label="Site navigation"
  >
    <nav
      class="mx-auto flex w-full max-w-wide flex-col px-5 py-2 sm:px-6 lg:px-10 2xl:px-12"
      aria-label="Mobile"
    >
      <a
        href="/"
        class="border-b border-line/80 py-3 text-base font-medium text-ink no-underline transition-colors hover:text-sageDark"
        aria-current={isActive("/") ? "page" : undefined}
      >
        Home
      </a>
      <div class="border-b border-line/80 py-3">
        <a
          href="/services"
          class="text-base font-medium text-ink no-underline transition-colors hover:text-sageDark"
          aria-current={servicesActive ? "page" : undefined}
        >
          Services
        </a>
        <div class="mt-2 flex flex-col gap-1 border-l border-sand/80 pl-4">
          {
            serviceItems.map((item) => (
              <a
                href={item.href}
                class="rounded-lg py-2 pl-2 text-base font-medium text-ink/90 no-underline transition-colors hover:bg-sageSoft hover:text-sageDark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2"
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.title}
              </a>
            ))
          }
        </div>
      </div>
      {
        navRest.map((item) => (
          <a
            href={item.href}
            class="border-b border-line/80 py-3 text-base font-medium text-ink no-underline transition-colors hover:text-sageDark"
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/contact-get-started"
        class="mt-4 mb-4 inline-flex w-full items-center justify-center rounded-full bg-sageDark px-6 py-3 text-base font-semibold text-paper no-underline transition-colors hover:bg-sage hover:text-paper focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
      >
        Get Started
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.getElementById("header-nav-toggle");
    var drawer = document.getElementById("header-mobile-drawer");
    var wrap = document.querySelector(".header-svc-wrap");
    var btn = document.getElementById("header-svc-btn");
    var flyout = document.getElementById("header-svc-flyout");

    function setMobileOpen(open) {
      if (!toggle || !drawer) return;
      drawer.classList.toggle("hidden", !open);
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    }

    if (toggle && drawer) {
      toggle.addEventListener("click", function () {
        var open = drawer.classList.contains("hidden");
        setMobileOpen(open);
      });
      drawer.querySelectorAll("a").forEach(function (a) {
        a.addEventListener("click", function () {
          setMobileOpen(false);
        });
      });
    }

    function setServicesOpen(open) {
      if (!wrap || !btn || !flyout) return;
      wrap.classList.toggle("menu-open", open);
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    }

    function closeServices() {
      setServicesOpen(false);
    }

    if (btn && wrap && flyout) {
      btn.addEventListener("click", function (e) {
        e.preventDefault();
        e.stopPropagation();
        var open = !wrap.classList.contains("menu-open");
        setServicesOpen(open);
      });
      document.addEventListener("click", function (e) {
        if (wrap && !wrap.contains(e.target)) closeServices();
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") closeServices();
      });
      flyout.querySelectorAll("a").forEach(function (a) {
        a.addEventListener("click", function () {
          closeServices();
        });
      });
    }
  })();
</script>
