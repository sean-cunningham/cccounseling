---
interface Props {
  heading: string;
  sub?: string;
}

const { heading, sub } = Astro.props;
---

<main id="main" class="border-b border-line bg-paper py-16 sm:py-24">
  <div class="section-px mx-auto max-w-site">
    <h1 class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{heading}</h1>
    {
      sub && (
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{sub}</p>
      )
    }
    <div
      class="mt-10 max-w-2xl space-y-5 text-[0.9375rem] leading-relaxed text-muted [&_a]:font-medium [&_a]:text-sageDark [&_a]:underline [&_a]:decoration-sand [&_a]:underline-offset-4 [&_a]:transition-colors hover:[&_a]:text-clay hover:[&_a]:decoration-clay"
    >
      <slot />
    </div>
  </div>
</main>
